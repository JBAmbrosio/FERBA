<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         QUIÉNES SOMOS  —  réplica de "QUIENES SOMOS.pdf"
         Copia literal del diseño salvo tres erratas evidentes del PDF que
         no tiene sentido publicar: "INTERNACIÓNAL", "tecnologica" y
         "contínuas". El resto del texto va tal cual lo entregó el cliente.
         ================================================================ -->
    <template id="pagina_quienes_somos" track="True" name="Ferba — Quiénes somos">
        <t t-call="ferba_website.pagina_base">
            <t t-set="titulo">Ingeniería postcosecha<br/>con visión internacional</t>
            <t t-set="fondo">quienes-somos-01-1171x659.webp</t>
            <t t-set="intro">
                <p class="o_ferba_hero__lead">
                    <strong>FERBA</strong> es una marca especializada en el diseño, fabricación
                    e integración de maquinaria agroindustrial para procesos postcosecha.
                    Con raíces españolas y más de 20 años de enfoque en innovación tecnológica,
                    desarrollamos soluciones para empacadoras que buscan mejor eficiencia,
                    precisión y calidad.
                </p>
                <p class="o_ferba_hero__cred">
                    <img src="/ferba_website/static/src/img/iconos/contacto-ubicacion.svg" alt=""/>
                    <span>Presencia comercial en Estados Unidos, España, México y Perú</span>
                </p>
            </t>
            <t t-set="acciones">
                <a href="/soluciones" class="o_ferba_btn o_ferba_btn--solid">
                    <span class="o_ferba_btn__label">Conocer soluciones</span>
                    <t t-call="ferba_website.flecha"/>
                </a>
                <a href="/maquinaria" class="o_ferba_btn o_ferba_btn--ghost">
                    <span class="o_ferba_btn__label">Ver maquinaria</span>
                    <t t-call="ferba_website.flecha"/>
                </a>
            </t>
            <t t-set="cierre_titulo">Construyamos una línea<br/>más eficiente para tu operación</t>
            <t t-set="cierre_texto">Cuéntanos qué producto procesas, qué capacidad necesitas y qué etapa quieres mejorar.</t>
            <t t-set="cierre_foto">quienes-somos-08-1171x659.webp</t>

            <!-- ============ Tecnología para transformar la postcosecha ============ -->
            <section class="o_ferba_section o_ferba_section--light">
                <div class="o_ferba_container">
                    <div class="o_ferba_split o_ferba_split--render">
                        <div class="o_ferba_reveal">
                            <h2 class="o_ferba_title"><span class="o_ferba_title__in">Tecnología para transformar la postcosecha</span></h2>
                            <span class="o_ferba_rule"/>
                            <p class="mt-4">
                                En <strong>FERBA</strong> desarrollamos maquinaria y sistemas para cada etapa del
                                proceso postcosecha: recepción, lavado, secado, cepillado, transporte,
                                selección, empaque y automatización.
                            </p>
                            <p>
                                Combinamos experiencia industrial, conocimiento agrícola e innovación
                                tecnológica para entregar soluciones que mejoran la eficiencia operativa,
                                protegen la calidad del producto y generan valor a largo plazo.
                            </p>
                        </div>
                        <div class="o_ferba_split__media o_ferba_reveal o_ferba_reveal--wipe">
                            <img src="/ferba_website/static/src/img/quienes-somos-render-620x287.webp"
                                 alt="Línea postcosecha FERBA en representación técnica"
                                 width="620" height="287" class="o_ferba_split__img o_ferba_split__img--recorte" loading="lazy"/>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ============ Nuestra historia ============ -->
            <section class="o_ferba_section o_ferba_section--foto"
                     style="--ferba-foto:url('/ferba_website/static/src/img/quienes-somos-03-1728x972.webp')">
                <div class="o_ferba_container">
                    <t t-call="ferba_website.titulo_seccion">
                        <t t-set="titulo">Nuestra historia</t>
                        <t t-set="llano" t-value="True"/>
                    </t>
                    <t t-set="hitos" t-value="[
                        ('qs-origen.svg',     'Origen',     'Raíces españolas y experiencia enfocada en maquinaria agroindustrial para la postcosecha.'),
                        ('qs-evolucion.svg',  'Evolución',  'Desarrollo de equipos, líneas de proceso y soluciones adaptadas a diferentes frutas y hortalizas.'),
                        ('qs-actualidad.svg', 'Actualidad', 'Presencia comercial en Estados Unidos, España, México y Perú. Con integración de automatización, visión artificial e inteligencia artificial.'),
                    ]"/>
                    <div class="o_ferba_hitos" data-ferba-grupo="hitos">
                        <t t-foreach="hitos" t-as="h">
                            <div class="o_ferba_hito o_ferba_reveal">
                                <div class="o_ferba_hito__icono">
                                    <img t-attf-src="/ferba_website/static/src/img/iconos/#{h[0]}" alt="" loading="lazy"/>
                                </div>
                                <h3 class="o_ferba_hito__titulo" t-out="h[1]"/>
                                <p class="o_ferba_hito__texto" t-out="h[2]"/>
                            </div>
                        </t>
                    </div>
                </div>
            </section>

            <!-- ============ Lo que nos diferencia ============ -->
            <section class="o_ferba_section o_ferba_section--light">
                <div class="o_ferba_container">
                    <t t-call="ferba_website.titulo_seccion">
                        <t t-set="titulo">Lo que nos diferencia</t>
                        <t t-set="llano" t-value="True"/>
                    </t>
                    <t t-set="diferencias" t-value="[
                        ('qs-ingenieria.svg',     'Ingeniería a medida',      'Diseñamos soluciones considerando el producto, espacio disponible, capacidad de proceso y objetivos de cada empacadora.'),
                        ('qs-experiencia.svg',    'Experiencia postcosecha',  'Conocemos las etapas críticas del manejo hortofrutícola y desarrollamos equipos para mejorar flujo, cuidado del producto y eficiencia.'),
                        ('qs-innovacion.svg',     'Innovación tecnológica',   'Integramos automatización, sistemas de control y visión artificial para elevar la precisión de los procesos.'),
                        ('qs-acompanamiento.svg', 'Acompañamiento integral',  'Participamos desde el diseño de la solución hasta la fabricación, instalación, puesta en marcha, capacitación y soporte técnico.'),
                    ]"/>
                    <div class="o_ferba_fichas" data-ferba-grupo="diferencias">
                        <t t-foreach="diferencias" t-as="d">
                            <div class="o_ferba_ficha o_ferba_reveal">
                                <div class="o_ferba_ficha__icono">
                                    <img t-attf-src="/ferba_website/static/src/img/iconos/#{d[0]}" alt="" loading="lazy"/>
                                </div>
                                <h3 class="o_ferba_ficha__titulo" t-out="d[1]"/>
                                <p class="o_ferba_ficha__texto" t-out="d[2]"/>
                            </div>
                        </t>
                    </div>
                </div>
            </section>

            <!-- ============ Valores ============ -->
            <section class="o_ferba_section o_ferba_section--foto"
                     style="--ferba-foto:url('/ferba_website/static/src/img/quienes-somos-04-960x721.webp')">
                <div class="o_ferba_container">
                    <t t-call="ferba_website.titulo_seccion">
                        <t t-set="titulo">Valores que impulsan nuestra ingeniería</t>
                        <t t-set="llano" t-value="True"/>
                    </t>
                    <t t-set="valores" t-value="[
                        ('val-innovacion.svg',    'Innovación',           'Buscamos mejoras continuas para anticipar las necesidades del futuro.'),
                        ('val-precision.svg',     'Precisión',            'Diseñamos y fabricamos con rigor para garantizar resultados confiables.'),
                        ('val-compromiso.svg',    'Compromiso',           'Cumplimos lo que prometemos y cuidamos cada detalle.'),
                        ('val-calidad.svg',       'Calidad',              'Equipos robustos, eficientes y construidos para durar.'),
                        ('val-adaptabilidad.svg', 'Adaptabilidad',        'Soluciones fiables que se ajustan a cada producto, proceso y cliente.'),
                        ('val-vision.svg',        'Visión internacional', 'Pensamos global para ofrecer tecnología con estándares mundiales.'),
                    ]"/>
                    <div class="o_ferba_valores" style="--ferba-cols:6" data-ferba-grupo="valores">
                        <t t-foreach="valores" t-as="v">
                            <div class="o_ferba_valor o_ferba_reveal">
                                <div class="o_ferba_valor__icono">
                                    <img t-attf-src="/ferba_website/static/src/img/iconos/#{v[0]}" alt="" loading="lazy"/>
                                </div>
                                <h3 class="o_ferba_valor__titulo" t-out="v[1]"/>
                                <p class="o_ferba_valor__texto" t-out="v[2]"/>
                            </div>
                        </t>
                    </div>
                </div>
            </section>

