<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         CATÁLOGO  —  páginas dinámicas (controllers/catalogo.py)

           /maquinaria/<categoria>              pagina_categoria
           /maquinaria/<categoria>/<maquina>    pagina_maquina
           /frutos/<fruto>                      pagina_fruto

         Reutilizan el andamio de las interiores (pagina_base: hero + banda
         de cierre + botón de WhatsApp) y el SCSS de marca; lo propio del
         catálogo (tarjetas de máquina, tabla de datos técnicos, pasos y
         galería) se estila en static/src/scss/ferba_catalogo.scss.
         ================================================================ -->

    <!-- ============ snippet: tarjeta de máquina ============
         Se reutiliza en la página de categoría y en la de fruto. El enlace es
         SIEMPRE la URL canónica de la ficha (bajo su categoría), venga de donde
         venga: una máquina = una página. -->
    <template id="tarjeta_maquina" name="Ferba — tarjeta de máquina">
        <a t-attf-href="/maquinaria/#{maq.categoria_id.slug}/#{maq.slug}"
           class="o_ferba_maqcard o_ferba_reveal"
           t-attf-data-ferba-senal="interes_maquina:#{maq.slug}">
            <span class="o_ferba_maqcard__media">
                <img t-attf-src="/ferba_website/static/src/img/#{maq.tarjeta_imagen}"
                     t-att-alt="maq.nombre" loading="lazy"/>
            </span>
            <span class="o_ferba_maqcard__body">
                <span class="o_ferba_maqcard__nombre" t-out="maq.nombre"/>
                <span t-if="maq.chip_lista" class="o_ferba_maqcard__chips">
                    <t t-foreach="maq.chip_lista" t-as="chip">
                        <span class="o_ferba_chip" t-out="chip"/>
                    </t>
                </span>
                <span class="o_ferba_maqcard__enlace">
                    Conocer equipo <t t-call="ferba_website.flecha"/>
                </span>
            </span>
        </a>
    </template>

    <!-- ============ snippet: bloque de tarjetas con icono ============ -->
    <template id="bloque_tarjetas" name="Ferba — bloque de tarjetas">
        <section t-attf-class="o_ferba_section o_ferba_section--#{'dark' if bloque.tema == 'oscuro' else 'light'}">
            <div class="o_ferba_container">
                <t t-if="bloque.titulo" t-call="ferba_website.titulo_seccion">
                    <t t-set="llano" t-value="True"/>
                    <t t-set="titulo" t-value="bloque.titulo"/>
                </t>
                <div class="o_ferba_valores" t-attf-style="--ferba-cols:#{len(bloque.item_ids) or 1}">
                    <t t-foreach="bloque.item_ids" t-as="it">
                        <div class="o_ferba_valor o_ferba_reveal">
                            <div t-if="it.icono" class="o_ferba_valor__icono">
                                <img t-attf-src="/ferba_website/static/src/img/#{it.icono}" alt="" loading="lazy"/>
                            </div>
                            <h3 class="o_ferba_valor__titulo" t-out="it.titulo"/>
                            <p class="o_ferba_valor__texto" t-out="it.texto"/>
                        </div>
                    </t>
                </div>
            </div>
        </section>
    </template>

    <!-- ============ snippet: tarjetas de beneficio (icono a la izquierda del título) ============ -->
    <template id="benecards" name="Ferba — tarjetas de beneficio">
        <div class="o_ferba_benecards" data-ferba-grupo="">
            <t t-foreach="maquina.puntos('beneficio')" t-as="b">
                <div class="o_ferba_benecard o_ferba_reveal">
                    <div class="o_ferba_benecard__cab">
                        <span t-if="b.icono" class="o_ferba_benecard__ico">
                            <img t-attf-src="/ferba_website/static/src/img/#{b.icono}?v=#{ver}" alt="" loading="lazy"/>
                        </span>
                        <h3><t t-out="b.titulo"/><span t-if="b.subtitulo" class="o_ferba_benecard__sub" t-out="b.subtitulo"/></h3>
                    </div>
                    <p t-out="b.texto"/>
                </div>
            </t>
        </div>
    </template>

    <!-- ============ snippet: bloque split (texto + imagen) ============ -->
    <template id="bloque_split" name="Ferba — bloque split">
        <section t-attf-class="o_ferba_section o_ferba_section--#{'dark' if bloque.tema == 'oscuro' else 'white'}">
            <div class="o_ferba_container">
                <div class="o_ferba_split">
                    <div class="o_ferba_reveal">
                        <span t-if="bloque.antetitulo" class="o_ferba_eyebrow" t-out="bloque.antetitulo"/>
                        <h2 class="o_ferba_title"><span class="o_ferba_title__in" t-out="bloque.titulo"/></h2>
                        <span class="o_ferba_rule"/>
                        <t t-out="bloque.cuerpo"/>
                    </div>
                    <div t-if="bloque.imagen" class="o_ferba_split__media o_ferba_reveal o_ferba_reveal--wipe">
                        <img t-attf-src="/ferba_website/static/src/img/#{bloque.imagen}"
                             t-att-alt="bloque.titulo" class="o_ferba_split__img" loading="lazy"/>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- ================================================================
         PÁGINA DE CATEGORÍA
         ================================================================ -->
    <template id="pagina_categoria" name="Ferba — categoría de maquinaria">
        <t t-call="ferba_website.pagina_base">
            <t t-set="antetitulo">Maquinaria</t>
            <t t-set="titulo" t-value="categoria.hero_titulo or categoria.nombre"/>
            <t t-set="subtitulo" t-value="categoria.hero_subtitulo"/>
            <t t-set="fondo" t-value="categoria.hero_imagen"/>
            <t t-set="clase_hero">o_ferba_hero--catalogo</t>
            <t t-set="intro"><t t-out="categoria.hero_intro"/></t>
            <t t-set="acciones">
                <a href="#equipos" class="o_ferba_btn o_ferba_btn--solid">
                    <span class="o_ferba_btn__label">Ver equipos</span>
                    <t t-call="ferba_website.flecha"/>
                </a>
                <a href="/contactenos" class="o_ferba_btn o_ferba_btn--ghost"
                   data-ferba-senal="contacto_directo:categoria">
                    <span class="o_ferba_btn__label">Solicitar asesoría</span>
                    <t t-call="ferba_website.flecha"/>
                </a>
            </t>
            <t t-set="cierre_titulo" t-value="categoria.cierre_titulo"/>
            <t t-set="cierre_texto" t-value="categoria.cierre_texto"/>
            <t t-set="cierre_foto" t-value="categoria.hero_imagen"/>
            <t t-set="cierre_acciones">
                <a href="/contactenos" class="o_ferba_btn o_ferba_btn--solid-white">
                    <span class="o_ferba_btn__label">Cotizar solución</span>
                    <t t-call="ferba_website.flecha"/>
                </a>
                <a href="https://wa.me/526671217267" target="_blank" rel="noopener" class="o_ferba_btn o_ferba_btn--ghost">
                    <span class="o_ferba_btn__label">Hablar con un asesor</span>
                    <t t-call="ferba_website.flecha"/>
                </a>
            </t>

            <!-- narrativa de la etapa + flujo de la línea -->
            <section t-if="categoria.narrativa_titulo or categoria.flujo_ids"
                     class="o_ferba_section o_ferba_section--light">
                <div class="o_ferba_container">
                    <div t-if="categoria.narrativa_titulo" class="o_ferba_narrativa o_ferba_reveal">
                        <span t-if="categoria.narrativa_antetitulo" class="o_ferba_eyebrow" t-out="categoria.narrativa_antetitulo"/>
                        <h2 class="o_ferba_title"><span class="o_ferba_title__in" t-out="categoria.narrativa_titulo"/></h2>
                        <span class="o_ferba_rule"/>
                        <div class="o_ferba_narrativa__intro"><t t-out="categoria.narrativa_intro"/></div>
                    </div>

                    <div t-if="categoria.flujo_ids" class="o_ferba_flujocat" data-ferba-grupo="">
                        <t t-foreach="categoria.flujo_ids" t-as="paso">
                            <div class="o_ferba_flujocat__paso o_ferba_reveal">
                                <div class="o_ferba_flujocat__marca">
                                    <img t-if="paso.icono" t-attf-src="/ferba_website/static/src/img/#{paso.icono}" alt="" loading="lazy"/>
                                    <span t-else="" class="o_ferba_flujocat__num" t-out="'%02d' % (paso_index + 1)"/>
                                    <span t-if="not paso_last" class="o_ferba_flujocat__flecha" aria-hidden="true">
                                        <img src="/ferba_website/static/src/img/iconos/chevron-rojo.svg" alt="" loading="lazy"/>
                                    </span>
                                </div>
                                <span class="o_ferba_flujocat__rotulo" t-out="paso.etiqueta"/>
                            </div>
                        </t>
                    </div>
                </div>
            </section>

            <!-- nuestros equipos -->
            <section id="equipos" class="o_ferba_section o_ferba_section--white">
                <div class="o_ferba_container">
                    <t t-call="ferba_website.titulo_seccion">
                        <t t-set="titulo">Nuestros equipos</t>
                    </t>
                    <t t-foreach="grupos" t-as="g">
                        <t t-set="subgrupo" t-value="g[0]"/>
                        <div class="o_ferba_maqgrupo o_ferba_reveal">
                            <h3 t-if="subgrupo" class="o_ferba_maqgrupo__titulo">
                                <span class="o_ferba_maqgrupo__num" t-out="'%02d' % (g_index + 1)"/>
                                <span t-out="subgrupo.nombre"/>
                            </h3>
                            <div class="o_ferba_maqgrid">
                                <t t-foreach="g[1]" t-as="maq">
                                    <t t-call="ferba_website.tarjeta_maquina"/>
                                </t>
                            </div>
                        </div>
                    </t>
                </div>
            </section>

            <!-- factores -->
            <section t-if="categoria.factor_ids" class="o_ferba_section o_ferba_section--dark">
                <div class="o_ferba_container">
                    <t t-call="ferba_website.titulo_seccion">
                        <t t-set="llano" t-value="True"/>
                        <t t-set="titulo" t-value="categoria.factor_titulo or 'Factores que definen tu solución'"/>
                    </t>
                    <div class="o_ferba_valores" t-attf-style="--ferba-cols:#{len(categoria.factor_ids) or 1}">
                        <t t-foreach="categoria.factor_ids" t-as="f">
                            <div class="o_ferba_valor o_ferba_reveal">
                                <div t-if="f.icono" class="o_ferba_valor__icono">
                                    <img t-attf-src="/ferba_website/static/src/img/#{f.icono}" alt="" loading="lazy"/>
                                </div>
                                <h3 class="o_ferba_valor__titulo" t-out="f.titulo"/>
                                <p class="o_ferba_valor__texto" t-out="f.texto"/>
                            </div>
                        </t>
                    </div>
                </div>
            </section>
        </t>
    </template>

    <!-- ================================================================
         FICHA DE MÁQUINA
         ================================================================ -->
    <template id="pagina_maquina" name="Ferba — ficha de máquina">
        <t t-call="ferba_website.pagina_base">
            <!-- miga del PDF: "MAQUINARIA ——— LAVADO Y TRATAMIENTO" (negrita · raya roja · categoría) -->
            <t t-set="antetitulo"><span class="o_ferba_miga__a">Maquinaria</span><span class="o_ferba_miga__sep"/><span class="o_ferba_miga__b" t-out="categoria.nombre"/></t>
            <t t-set="titulo" t-value="maquina.hero_titulo or maquina.nombre"/>
            <t t-set="subtitulo" t-value="maquina.lema"/>
            <t t-set="fondo" t-value="maquina.hero_imagen"/>
            <!-- hero claro (transportadores): fondo blanco y el render 3D a la derecha -->
            <t t-set="clase_hero" t-value="'o_ferba_hero--catalogo o_ferba_hero--ficha' + (' o_ferba_hero--claro' if maquina.hero_tema == 'claro' else '')"/>
            <t t-set="intro">
                <t t-out="maquina.intro"/>
                <!-- badge flotante sobre la foto del hero ("HASTA 1,440 CAJAS/HORA") -->
                <div t-if="maquina.hero_badge_valor" class="o_ferba_herobadge">
                    <img t-if="maquina.hero_badge_icono" t-attf-src="/ferba_website/static/src/img/#{maquina.hero_badge_icono}?v=#{ver}" alt="" loading="lazy"/>
                    <span class="o_ferba_herobadge__txt">
                        <span t-if="maquina.hero_badge_prefijo" class="o_ferba_herobadge__pre" t-out="maquina.hero_badge_prefijo"/>
                        <span class="o_ferba_herobadge__val" t-out="maquina.hero_badge_valor"/>
                        <span t-if="maquina.hero_badge_etiqueta" class="o_ferba_herobadge__etq" t-out="maquina.hero_badge_etiqueta"/>
                    </span>
                </div>
                <div t-if="maquina.destacado_ids" class="o_ferba_fichabadges">
                    <t t-foreach="maquina.destacado_ids" t-as="d">
                        <span t-attf-class="o_ferba_fichabadge#{' o_ferba_fichabadge--dest' if maquina.destacados_estilo == 'valor' else ''}">
                            <img t-if="d.icono" t-attf-src="/ferba_website/static/src/img/#{d.icono}?v=#{ver}" alt="" loading="lazy"/>
                            <span t-if="maquina.destacados_estilo == 'valor'" class="o_ferba_fichabadge__txt">
                                <span class="o_ferba_fichabadge__val" t-out="d.valor"/>
                                <span t-if="d.etiqueta" class="o_ferba_fichabadge__etq" t-out="d.etiqueta"/>
                            </span>
                            <span t-else="" t-out="d.valor"/>
                        </span>
                    </t>
                </div>
            </t>
            <t t-set="acciones">
                <a t-attf-href="/maquinaria/#{categoria.slug}" class="o_ferba_btn o_ferba_btn--solid">
                    <span class="o_ferba_btn__label">Ver equipos</span>
                    <t t-call="ferba_website.flecha"/>
                </a>
                <a href="/contactenos" class="o_ferba_btn o_ferba_btn--ghost"
                   t-attf-data-ferba-senal="contacto_directo:#{maquina.slug}">
                    <span class="o_ferba_btn__label">Solicitar asesoría</span>
                    <t t-call="ferba_website.flecha"/>
                </a>
            </t>
            <t t-set="cierre_titulo" t-value="maquina.cierre_titulo"/>
            <t t-set="cierre_texto" t-value="maquina.cierre_texto"/>
            <!-- la banda roja de TODOS los PDF de máquina lleva la misma foto (línea con tomates) -->
            <t t-set="cierre_foto" t-value="maquina.cierre_imagen or 'catalogo/_comunes/cta-bg.webp'"/>
            <t t-set="cierre_acciones">
                <a href="/contactenos" class="o_ferba_btn o_ferba_btn--solid-white"
                   t-attf-data-ferba-senal="contacto_directo:#{maquina.slug}">
                    <span class="o_ferba_btn__label">Cotizar solución</span>
                    <t t-call="ferba_website.flecha"/>
                </a>
                <a href="https://wa.me/526671217267" target="_blank" rel="noopener" class="o_ferba_btn o_ferba_btn--ghost">
                    <span class="o_ferba_btn__label">Hablar con un asesor</span>
                    <t t-call="ferba_website.flecha"/>
                </a>
            </t>

            <!-- 1) splits ("cómo se integra a tu línea") -->
            <t t-foreach="splits" t-as="bloque">
                <t t-call="ferba_website.bloque_split"/>
            </t>

            <!-- 2) beneficios (tarjetas oscuras, compat. bloques antiguos) -->
            <t t-foreach="beneficios" t-as="bloque">
                <t t-call="ferba_website.bloque_tarjetas"/>
            </t>

            <!-- PDF · BENEFICIOS como sección propia (oscura): encabezado izq., tarjetas der. -->
            <section t-if="maquina.beneficios_pos == 'seccion' and maquina.puntos('beneficio')"
                     class="o_ferba_section o_ferba_section--dark">
                <div class="o_ferba_container">
                    <div class="o_ferba_benesec">
                        <div class="o_ferba_reveal">
                            <span class="o_ferba_eyebrow o_ferba_eyebrow--rojo" t-out="maquina.beneficios_antetitulo or 'Beneficios principales'"/>
                            <h2 class="o_ferba_title o_ferba_title--claro"><span class="o_ferba_title__in" t-out="maquina.beneficios_titulo"/></h2>
                        </div>
                        <t t-call="ferba_website.benecards"/>
                    </div>
                </div>
            </section>

            <!-- PDF · "una separación que protege toda la línea": texto + render + 3 puntos -->
            <section t-if="maquina.protege_titulo" class="o_ferba_section o_ferba_section--white">
                <div class="o_ferba_container">
                    <div class="o_ferba_protege">
                        <div class="o_ferba_protege__texto o_ferba_reveal">
                            <span t-if="maquina.protege_antetitulo" class="o_ferba_eyebrow" t-out="maquina.protege_antetitulo"/>
                            <h2 class="o_ferba_title"><span class="o_ferba_title__in" t-out="maquina.protege_titulo"/></h2>
                            <span class="o_ferba_rule"/>
                            <div class="o_ferba_prosa"><t t-out="maquina.protege_intro"/></div>
                        </div>
                        <div t-if="maquina.protege_imagen" class="o_ferba_protege__fig o_ferba_reveal o_ferba_reveal--wipe">
                            <img t-attf-src="/ferba_website/static/src/img/#{maquina.protege_imagen}?v=#{ver}" t-att-alt="maquina.nombre" loading="lazy"/>
                        </div>
                        <div class="o_ferba_protege__puntos" data-ferba-grupo="">
                            <t t-foreach="maquina.puntos('protege')" t-as="p">
                                <div class="o_ferba_puntoicono o_ferba_reveal">
                                    <span class="o_ferba_puntoicono__ico">
                                        <img t-if="p.icono and '/' in p.icono" t-attf-src="/ferba_website/static/src/img/#{p.icono}?v=#{ver}" alt="" loading="lazy"/>
                                        <span t-elif="p.icono" class="o_ferba_puntoicono__glifo" t-out="p.icono"/>
                                    </span>
                                    <div class="o_ferba_puntoicono__txt">
                                        <h3 t-out="p.titulo"/>
                                        <p t-out="p.texto"/>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </section>

            <!-- PDF · "EL RETO": tarjetas oscuras numeradas con ilustración -->
            <section t-if="maquina.reto_titulo" class="o_ferba_section o_ferba_section--dark">
                <div class="o_ferba_container">
                    <div class="o_ferba_reveal o_ferba_retocab">
                        <span class="o_ferba_eyebrow o_ferba_eyebrow--rojo" t-out="maquina.reto_antetitulo"/>
                        <h2 class="o_ferba_title o_ferba_title--claro"><span class="o_ferba_title__in"><t t-out="maquina.reto_titulo"/></span></h2>
                        <p t-if="maquina.reto_intro" class="o_ferba_retocab__sub" t-out="maquina.reto_intro"/>
                    </div>
                    <div class="o_ferba_retos" data-ferba-grupo="">
                        <t t-foreach="maquina.puntos('reto')" t-as="p">
                            <article class="o_ferba_retocard o_ferba_reveal">
                                <div class="o_ferba_retocard__cab">
                                    <span class="o_ferba_retocard__num" t-out="'%02d' % (p_index + 1)"/>
                                    <h3 t-out="p.titulo"/>
                                </div>
                                <p class="o_ferba_retocard__txt" t-out="p.texto"/>
                                <div t-if="p.imagen" class="o_ferba_retocard__ilustra">
                                    <img t-attf-src="/ferba_website/static/src/img/#{p.imagen}?v=#{ver}" alt="" loading="lazy"/>
                                </div>
                            </article>
                        </t>
                    </div>
                </div>
            </section>

            <!-- PDF · "CÓMO FUNCIONA": pasos en tarjeta con chevrón + diagrama -->
            <section t-if="maquina.paso_ids" class="o_ferba_section o_ferba_section--white">
                <div class="o_ferba_container">
                    <div class="o_ferba_reveal o_ferba_cabsec">
                        <span class="o_ferba_eyebrow" t-out="maquina.pasos_antetitulo or 'Cómo funciona'"/>
                        <h2 class="o_ferba_title"><span class="o_ferba_title__in" t-out="maquina.pasos_titulo or 'Cómo funciona'"/></h2>
                        <span class="o_ferba_rule"/>
                        <p t-if="maquina.pasos_intro" class="o_ferba_prosa" t-out="maquina.pasos_intro"/>
                    </div>
                    <t t-set="pasos_foto" t-value="any(p.imagen for p in maquina.paso_ids)"/>
                    <div t-attf-class="o_ferba_comofunciona#{' o_ferba_comofunciona--foto' if pasos_foto else ''}" data-ferba-grupo="">
                        <t t-foreach="maquina.paso_ids" t-as="p">
                            <span t-if="not p_first" class="o_ferba_comofunciona__chevron" aria-hidden="true">
                                <img src="/ferba_website/static/src/img/iconos/chevron-rojo.svg" alt="" loading="lazy"/>
                            </span>
                            <article class="o_ferba_pasocard o_ferba_reveal">
                                <t t-if="p.imagen">
                                    <span class="o_ferba_pasocard__num" t-out="'%02d' % (p_index + 1)"/>
                                    <div class="o_ferba_pasocard__foto">
                                        <img t-attf-src="/ferba_website/static/src/img/#{p.imagen}?v=#{ver}" t-att-alt="p.titulo" loading="lazy"/>
                                    </div>
                                    <h3 class="o_ferba_pasocard__tit" t-out="p.titulo"/>
                                </t>
                                <h3 t-else="" class="o_ferba_pasocard__tit"><span class="o_ferba_pasocard__n" t-out="(p_index + 1)"/>. <t t-out="p.titulo"/></h3>
                                <p class="o_ferba_pasocard__txt" t-out="p.texto"/>
                            </article>
                        </t>
                    </div>
                    <div t-if="maquina.diagrama_imagen" class="o_ferba_diagrama o_ferba_reveal o_ferba_reveal--wipe">
                        <img t-attf-src="/ferba_website/static/src/img/#{maquina.diagrama_imagen}?v=#{ver}" alt="" loading="lazy"/>
                    </div>
                </div>
            </section>

            <!-- PDF · "AJUSTE REGULABLE": render + tarjetas A/B/C -->
            <section t-if="maquina.ajuste_titulo" class="o_ferba_section o_ferba_section--white o_ferba_section--tighttop">
                <div class="o_ferba_container">
                    <div class="o_ferba_reveal o_ferba_cabsec">
                        <span t-if="maquina.ajuste_antetitulo" class="o_ferba_eyebrow" t-out="maquina.ajuste_antetitulo"/>
                        <h2 class="o_ferba_title"><span class="o_ferba_title__in" t-out="maquina.ajuste_titulo"/></h2>
                        <span class="o_ferba_rule"/>
                        <p t-if="maquina.ajuste_intro" class="o_ferba_prosa" t-out="maquina.ajuste_intro"/>
                    </div>
                    <div class="o_ferba_ajuste">
                        <figure t-if="maquina.ajuste_imagen" class="o_ferba_ajuste__fig o_ferba_reveal">
                            <img t-attf-src="/ferba_website/static/src/img/#{maquina.ajuste_imagen}?v=#{ver}" alt="" loading="lazy"/>
                            <figcaption t-if="maquina.ajuste_caption or maquina.ajuste_subcaption">
                                <span t-if="maquina.ajuste_caption" class="o_ferba_ajuste__cap" t-out="maquina.ajuste_caption"/>
                                <span t-if="maquina.ajuste_subcaption" class="o_ferba_ajuste__sub" t-out="maquina.ajuste_subcaption"/>
                            </figcaption>
                        </figure>
                        <div class="o_ferba_abc" data-ferba-grupo="">
                            <t t-foreach="maquina.puntos('ajuste')" t-as="p">
                                <div class="o_ferba_abccard o_ferba_reveal">
                                    <div class="o_ferba_abccard__cab">
                                        <span class="o_ferba_abccard__letra" t-out="'ABCDEF'[p_index] + ')'"/>
                                        <h3 t-out="p.titulo"/>
                                    </div>
                                    <div class="o_ferba_abccard__txt">
                                        <p t-out="p.texto"/>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                    <p t-if="maquina.ajuste_nota" class="o_ferba_ajuste__nota" t-out="maquina.ajuste_nota"/>
                </div>
            </section>

            <!-- PDF · "DATOS TÉCNICOS": specs en chips + (checklist+chips | beneficios) -->
            <t t-set="datos_benef" t-value="maquina.beneficios_pos != 'seccion' and maquina.puntos('beneficio')"/>
            <section t-if="maquina.spec_ids or maquina.puntos('caracteristica') or datos_benef" id="datos"
                     t-attf-class="o_ferba_section o_ferba_section--#{'dark' if maquina.datos_tema == 'oscuro' else 'white'}#{' o_ferba_section--datosfoto' if maquina.specs_foto else ''}">
                <div class="o_ferba_container">
                    <span class="o_ferba_eyebrow o_ferba_eyebrow--rojo o_ferba_reveal" t-out="maquina.datos_antetitulo or 'Datos técnicos'"/>
                    <div class="o_ferba_datos2">
                        <div t-if="maquina.spec_ids" class="o_ferba_reveal">
                            <h2 t-attf-class="o_ferba_title o_ferba_title--sm#{' o_ferba_title--claro' if maquina.datos_tema == 'oscuro' else ''}"><span class="o_ferba_title__in" t-out="maquina.specs_titulo or 'Especificaciones principales'"/></h2>
                            <ul class="o_ferba_specchips">
                                <t t-foreach="maquina.spec_ids" t-as="s">
                                    <li class="o_ferba_specchip">
                                        <span class="o_ferba_specchip__k" t-out="s.etiqueta"/>
                                        <span class="o_ferba_specchip__v" t-out="s.valor"/>
                                    </li>
                                </t>
                            </ul>
                        </div>
                        <!-- columna derecha: beneficios (tarjetas icono) O checklist+chips O foto a sangre -->
                        <div t-if="datos_benef" class="o_ferba_reveal">
                            <h2 t-attf-class="o_ferba_title o_ferba_title--sm#{' o_ferba_title--claro' if maquina.datos_tema == 'oscuro' else ''}"><span class="o_ferba_title__in" t-out="maquina.beneficios_titulo or 'Beneficios principales'"/></h2>
                            <t t-call="ferba_website.benecards"/>
                        </div>
                        <div t-elif="maquina.puntos('caracteristica')" class="o_ferba_reveal">
                            <h2 class="o_ferba_title o_ferba_title--sm"><span class="o_ferba_title__in" t-out="maquina.caracteristicas_titulo or 'Características destacadas'"/></h2>
                            <ul class="o_ferba_checklist">
                                <t t-foreach="maquina.puntos('caracteristica')" t-as="c">
                                    <li>
                                        <img src="/ferba_website/static/src/img/iconos/check-rojo.svg" alt="" loading="lazy"/>
                                        <span t-out="c.titulo"/>
                                    </li>
                                </t>
                            </ul>
                            <div t-if="maquina.puntos('chip')" class="o_ferba_chips">
                                <t t-foreach="maquina.puntos('chip')" t-as="ch">
                                    <div class="o_ferba_chip">
                                        <img t-if="ch.icono" t-attf-src="/ferba_website/static/src/img/#{ch.icono}?v=#{ver}" alt="" loading="lazy"/>
                                        <span t-out="ch.titulo"/>
                                    </div>
                                </t>
                            </div>
                        </div>
                        <!-- solo chips (sin checklist): tarjeta gris con filas icono + texto -->
                        <div t-elif="maquina.puntos('chip')" class="o_ferba_reveal o_ferba_chipcard">
                            <t t-foreach="maquina.puntos('chip')" t-as="ch">
                                <div class="o_ferba_chip">
                                    <img t-if="ch.icono" t-attf-src="/ferba_website/static/src/img/#{ch.icono}?v=#{ver}" alt="" loading="lazy"/>
                                    <span t-out="ch.titulo"/>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
                <!-- foto grande a sangre en la mitad derecha (volcadores, lavadoras…) -->
                <div t-if="maquina.specs_foto" class="o_ferba_datos__fotofull">
                    <img t-attf-src="/ferba_website/static/src/img/#{maquina.specs_foto}?v=#{ver}" t-att-alt="maquina.nombre" loading="lazy"/>
                </div>
            </section>

            <!-- PDF · "APLICACIONES": intro + tarjetas con foto -->
            <section t-if="maquina.puntos('aplica')" class="o_ferba_section o_ferba_section--white o_ferba_section--tighttop">
                <div class="o_ferba_container">
                    <div class="o_ferba_aplicawrap">
                        <div class="o_ferba_reveal o_ferba_aplicawrap__intro">
                            <span t-if="maquina.aplica_antetitulo" class="o_ferba_eyebrow" t-out="maquina.aplica_antetitulo"/>
                            <h2 class="o_ferba_title"><span class="o_ferba_title__in" t-out="maquina.aplica_titulo"/></h2>
                            <span class="o_ferba_rule"/>
                            <p t-if="maquina.aplica_intro" class="o_ferba_prosa" t-out="maquina.aplica_intro"/>
                        </div>
                        <div class="o_ferba_aplicaciones" data-ferba-grupo="">
                            <t t-foreach="maquina.puntos('aplica')" t-as="a">
                                <article class="o_ferba_aplica o_ferba_reveal">
                                    <div class="o_ferba_aplica__img">
                                        <img t-if="a.imagen" t-attf-src="/ferba_website/static/src/img/#{a.imagen}?v=#{ver}" t-att-alt="a.titulo" loading="lazy"/>
                                    </div>
                                    <h3 class="o_ferba_aplica__tit" t-out="a.titulo"/>
                                    <p class="o_ferba_aplica__txt" t-out="a.texto"/>
                                </article>
                            </t>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 5) características (tarjetas claras) -->
            <t t-foreach="caracteristicas" t-as="bloque">
                <t t-call="ferba_website.bloque_tarjetas"/>
            </t>

            <!-- ficha en preparación: cuando aún no hay cuerpo (M2) -->
            <section t-if="not (splits or beneficios or caracteristicas or maquina.paso_ids or maquina.spec_ids or maquina.media_ids or maquina.protege_titulo or maquina.reto_titulo or maquina.ajuste_titulo or maquina.punto_ids)"
                     class="o_ferba_section o_ferba_section--white">
                <div class="o_ferba_container o_ferba_stub">
                    <span class="o_ferba_eyebrow">En preparación</span>
                    <h2 class="o_ferba_title"><span class="o_ferba_title__in">Estamos preparando la ficha técnica de este equipo</span></h2>
                    <span class="o_ferba_rule"/>
                    <p class="o_ferba_stub__text">
                        Mientras tanto, cuéntanos tu necesidad y te asesoramos sobre capacidad, formato y nivel de automatización.
                    </p>
                    <div class="o_ferba_stub__actions">
                        <a href="/contactenos" class="o_ferba_btn o_ferba_btn--solid"
                           t-attf-data-ferba-senal="contacto_directo:#{maquina.slug}">
                            <span class="o_ferba_btn__label">Solicitar información</span>
                            <t t-call="ferba_website.flecha"/>
                        </a>
                        <a t-attf-href="/maquinaria/#{categoria.slug}" class="o_ferba_btn o_ferba_btn--ghost">
                            <span class="o_ferba_btn__label">Ver la categoría</span>
                            <t t-call="ferba_website.flecha"/>
                        </a>
                    </div>
                </div>
            </section>

            <!-- 6) galería -->
            <section t-if="maquina.media_ids" class="o_ferba_section o_ferba_section--light">
                <div class="o_ferba_container">
                    <t t-call="ferba_website.titulo_seccion">
                        <t t-set="llano" t-value="True"/>
                        <t t-set="titulo" t-value="maquina.galeria_titulo or 'Galería de imágenes y video'"/>
                    </t>
                    <div class="o_ferba_galeria">
                        <t t-foreach="maquina.media_ids" t-as="m">
                            <t t-if="m.es_video">
                                <a t-att-href="m.video_url or '#'" target="_blank" rel="noopener"
                                   class="o_ferba_galeria__item o_ferba_galeria__item--video o_ferba_reveal">
                                    <img t-attf-src="/ferba_website/static/src/img/#{m.imagen}?v=#{ver}" alt="Video" loading="lazy"/>
                                    <span class="o_ferba_galeria__play" aria-hidden="true"/>
                                </a>
                            </t>
                            <span t-else="" class="o_ferba_galeria__item o_ferba_reveal">
                                <img t-attf-src="/ferba_website/static/src/img/#{m.imagen}?v=#{ver}" t-att-alt="maquina.nombre" loading="lazy"/>
                            </span>
                        </t>
                    </div>
                </div>
            </section>
        </t>
    </template>

    <!-- ================================================================
         PÁGINA DE FRUTO
         ================================================================ -->
    <template id="pagina_fruto" name="Ferba — fruto">
        <t t-call="ferba_website.pagina_base">
            <t t-set="antetitulo">Frutos</t>
            <t t-set="titulo" t-value="fruto.hero_titulo or fruto.nombre"/>
            <t t-set="subtitulo" t-value="fruto.hero_subtitulo"/>
            <t t-set="fondo" t-value="fruto.hero_imagen"/>
            <t t-set="clase_hero">o_ferba_hero--catalogo</t>
            <t t-set="intro"><t t-out="fruto.hero_intro"/></t>
            <t t-set="acciones">
                <a href="#equipos" class="o_ferba_btn o_ferba_btn--solid">
                    <span class="o_ferba_btn__label">Ver equipos</span>
                    <t t-call="ferba_website.flecha"/>
                </a>
                <a href="/contactenos" class="o_ferba_btn o_ferba_btn--ghost"
                   t-attf-data-ferba-senal="interes_fruto:#{fruto.slug}">
                    <span class="o_ferba_btn__label">Solicitar asesoría</span>
                    <t t-call="ferba_website.flecha"/>
                </a>
            </t>
            <t t-set="cierre_titulo" t-value="fruto.cierre_titulo"/>
            <t t-set="cierre_texto" t-value="fruto.cierre_texto"/>
            <t t-set="cierre_foto" t-value="fruto.hero_imagen"/>
            <t t-set="cierre_acciones">
                <a href="/contactenos" class="o_ferba_btn o_ferba_btn--solid-white"
                   t-attf-data-ferba-senal="interes_fruto:#{fruto.slug}">
                    <span class="o_ferba_btn__label">Cotizar solución</span>
                    <t t-call="ferba_website.flecha"/>
                </a>
                <a href="https://wa.me/526671217267" target="_blank" rel="noopener" class="o_ferba_btn o_ferba_btn--ghost">
                    <span class="o_ferba_btn__label">Hablar con un asesor</span>
                    <t t-call="ferba_website.flecha"/>
                </a>
            </t>

            <!-- nuestros equipos, agrupados por etapa -->
            <section id="equipos" class="o_ferba_section o_ferba_section--white">
                <div class="o_ferba_container">
                    <t t-call="ferba_website.titulo_seccion">
                        <t t-set="titulo">Nuestros equipos</t>
                    </t>
                    <t t-foreach="grupos" t-as="g">
                        <t t-set="etapa" t-value="g[0]"/>
                        <div class="o_ferba_maqgrupo o_ferba_reveal">
                            <h3 class="o_ferba_maqgrupo__titulo">
                                <span class="o_ferba_maqgrupo__num" t-out="'%02d' % (g_index + 1)"/>
                                <span t-out="etapa.nombre"/>
                            </h3>
                            <div class="o_ferba_maqgrid">
                                <t t-foreach="g[1]" t-as="maq">
                                    <t t-call="ferba_website.tarjeta_maquina"/>
                                </t>
                            </div>
                        </div>
                    </t>
                </div>
            </section>
        </t>
    </template>

</odoo>
