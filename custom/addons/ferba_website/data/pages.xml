<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate="1" a propósito.

         El módulo CREA las páginas con una URL razonable, pero a partir de
         ahí las URLs son configuración del sitio, no contenido del módulo:
         quien decide cuál es la portada es Ferba desde el backend, no este
         archivo. Sin este noupdate, cada actualización del módulo pisaría
         ese cambio y la portada volvería a /inicio-ferba sin avisar.

         Consecuencia a tener presente: cambiar aquí el nombre o la URL de
         una página YA CREADA no surte efecto. Para eso, el backend
         (Sitio web > Sitio > Páginas). Las páginas nuevas sí se crean
         normalmente, porque llevan un id que todavía no existe. -->
    <data noupdate="1">

        <!-- La PORTADA. En Odoo 19 la portada es, literalmente, la página cuya
             URL es '/' (website.page._get_page_info compara la ruta tal
             cual; website.homepage_url queda vacío). La «Home» de fábrica de
             Odoo también nace en '/': la elimina hooks.fijar_portada, que
             corre al instalar (post_init_hook) y, en bases que ya tenían la
             página en /inicio-ferba, en la migración 19.0.1.5.0 — que además
             la mueve aquí y deja un 301 de /inicio-ferba a '/'. -->
        <record id="page_ferba_inicio" model="website.page">
            <field name="name">Ferba — Inicio</field>
            <field name="url">/</field>
            <field name="view_id" ref="ferba_website.pagina_inicio"/>
            <field name="website_indexed" eval="True"/>
            <field name="is_published" eval="True"/>
        </record>

        <!-- Las 8 páginas del menú + 2 legales. Todas se indexan: el título y
             la descripción para el buscador los pone hooks.aplicar_indexacion,
             que corre al instalar y en cada migración que los toca. Las dos
             legales estuvieron fuera del buscador hasta la 19.0.1.9.0, que es
             cuando dejaron de ser el andamio «en preparación». -->
        <record id="page_quienes_somos" model="website.page">
            <field name="name">Ferba — Quiénes somos</field>
            <field name="url">/quienes-somos</field>
            <field name="view_id" ref="ferba_website.pagina_quienes_somos"/>
            <field name="website_indexed" eval="True"/>
            <field name="is_published" eval="True"/>
        </record>
