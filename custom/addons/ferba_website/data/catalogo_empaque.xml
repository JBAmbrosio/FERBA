<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================
         CONTENIDO M1 — Categoría EMPAQUE + sus 16 máquinas + ficha FLOWPACK

         Rebanada vertical de demostración (ver
         docs/ferba-web-catalogo-arquitectura-2026-11-03.md). El copy y las
         imágenes salen del PDF de diseño del cliente (Empaque.pdf y
         Flowpack.pdf). La ficha de FLOWPACK va completa; las otras 15 máquinas
         llevan solo su tarjeta (nombre + chips + miniatura) y su ficha detallada
         se poblará en M2.

         Actualizable a propósito (sin noupdate) mientras el contenido se afina;
         se marcará noupdate antes del cierre, para que FERBA pueda editar.
         ================================================================ -->
    <data>

        <!-- ============ CATEGORÍA ============ -->
        <record id="cat_empaque" model="ferba.categoria">
            <field name="nombre">Empaque</field>
            <field name="slug">empaque</field>
            <field name="secuencia">60</field>
            <field name="hero_titulo">Soluciones de empaque para el final de la línea</field>
            <field name="hero_imagen">catalogo/empaque/hero.webp</field>
            <field name="hero_intro"><![CDATA[
                <p class="o_ferba_hero__lead">La etapa de empaque transforma el producto seleccionado y calibrado en una presentación lista para manejo, almacenamiento, distribución o comercialización.</p>
                <p class="o_ferba_hero__lead">En FERBA integramos equipos para pesaje, llenado, acomodo, sellado, envasado y empaque automático, adaptando cada solución al producto, formato de presentación, capacidad y nivel de automatización requerido.</p>
            ]]></field>
            <field name="narrativa_antetitulo">Del producto clasificado al empaque final</field>
            <field name="narrativa_titulo">El formato final también forma parte del proceso</field>
            <field name="narrativa_intro"><![CDATA[
                <p>Después de la selección y calibrado, cada producto puede requerir una presentación diferente: cajas, bolsas, clamshells u otros formatos comerciales.</p>
                <p>Por eso la etapa de empaque puede combinar estaciones manuales, sistemas de pesaje, llenado, sellado, envasado y automatización según las necesidades de cada operación.</p>
            ]]></field>
            <field name="factor_titulo">Configuramos el empaque según tu operación</field>
            <field name="cierre_titulo">¿Qué presentación necesita tu producto?</field>
            <field name="cierre_texto">Cuéntanos qué producto procesas, qué capacidad necesitas y qué etapa quieres mejorar. Nuestro equipo puede ayudarte a definir si tu operación requiere una línea completa, modernización, automatización o un proyecto llave en mano.</field>
            <field name="meta_titulo">Maquinaria de empaque postcosecha | FERBA</field>
            <field name="meta_descripcion">Pesaje, llenado, acomodo, sellado, envasado y empaque automático para el final de la línea postcosecha. Estaciones asistidas y sistemas automáticos completos.</field>
        </record>

        <!-- flujo de la etapa (sin iconos por ahora: solo rótulos) -->
        <record id="flujo_emp_1" model="ferba.categoria.flujo"><field name="categoria_id" ref="cat_empaque"/><field name="secuencia">10</field><field name="etiqueta">Producto clasificado</field></record>
        <record id="flujo_emp_2" model="ferba.categoria.flujo"><field name="categoria_id" ref="cat_empaque"/><field name="secuencia">20</field><field name="etiqueta">Pesaje / dosificación</field></record>
        <record id="flujo_emp_3" model="ferba.categoria.flujo"><field name="categoria_id" ref="cat_empaque"/><field name="secuencia">30</field><field name="etiqueta">Llenado / acomodo</field></record>
        <record id="flujo_emp_4" model="ferba.categoria.flujo"><field name="categoria_id" ref="cat_empaque"/><field name="secuencia">40</field><field name="etiqueta">Sellado / envasado</field></record>
        <record id="flujo_emp_5" model="ferba.categoria.flujo"><field name="categoria_id" ref="cat_empaque"/><field name="secuencia">50</field><field name="etiqueta">Producto empacado</field></record>

        <!-- factores -->
        <record id="factor_emp_1" model="ferba.categoria.factor"><field name="categoria_id" ref="cat_empaque"/><field name="secuencia">10</field><field name="titulo">Tipo de producto</field><field name="texto">Las características del fruto influyen en el sistema de manejo y empaque requerido.</field>
        <field name="icono">iconos/info-producto.svg</field>
    </record>
        <record id="factor_emp_2" model="ferba.categoria.factor"><field name="categoria_id" ref="cat_empaque"/><field name="secuencia">20</field><field name="titulo">Presentación</field><field name="texto">Caja, bolsa, clamshell u otro formato comercial requerido.</field>
        <field name="icono">iconos/adapt-empaque.svg</field>
    </record>
        <record id="factor_emp_3" model="ferba.categoria.factor"><field name="categoria_id" ref="cat_empaque"/><field name="secuencia">30</field><field name="titulo">Peso y cantidad</field><field name="texto">La solución se configura según el peso o cantidad objetivo de cada presentación.</field>
        <field name="icono">iconos/info-capacidad.svg</field>
    </record>
        <record id="factor_emp_4" model="ferba.categoria.factor"><field name="categoria_id" ref="cat_empaque"/><field name="secuencia">40</field><field name="titulo">Capacidad y automatización</field><field name="texto">El volumen requerido determina el nivel de automatización y configuración del sistema.</field>
        <field name="icono">iconos/adapt-capacidad.svg</field>
    </record>

        <!-- subgrupos -->
        <record id="sg_emp_estaciones" model="ferba.categoria.subgrupo"><field name="categoria_id" ref="cat_empaque"/><field name="secuencia">10</field><field name="nombre">Estaciones de empaque</field></record>
        <record id="sg_emp_pesaje" model="ferba.categoria.subgrupo"><field name="categoria_id" ref="cat_empaque"/><field name="secuencia">20</field><field name="nombre">Pesaje y llenado</field></record>
