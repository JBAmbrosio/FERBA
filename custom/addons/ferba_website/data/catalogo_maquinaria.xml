<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================
         CONTENIDO M2 — las 5 categorías restantes de maquinaria
         (Recepción, Lavado, Secado, Transportadores, Selección) con sus
         equipos (tarjeta), y SEMBRADORAS como ficha completa "Línea de
         siembra" (su PDF es una ficha, no un listado).

         Copy e imágenes del diseño entregado por el cliente. Las fichas de
         las máquinas de estas categorías (salvo Línea de siembra) se
         poblarán después; por ahora llevan su tarjeta y la ficha muestra el
         stub "en preparación". Falta la categoría Automatización (el cliente
         no entregó su diseño).

         Nota: algunas miniaturas son mapeo best-guess (calibradores y
         transportadores son visualmente casi idénticos entre variantes);
         conviene una revisión rápida.
         ================================================================ -->
    <data>

        <!-- ============================================================ -->
        <!-- RECEPCIÓN Y ALIMENTACIÓN                                     -->
        <!-- ============================================================ -->
        <record id="cat_recepcion" model="ferba.categoria">
            <field name="nombre">Recepción y alimentación</field>
            <field name="slug">recepcion</field>
            <field name="secuencia">10</field>
            <field name="hero_titulo">Recepción y alimentación de producto</field>
            <field name="hero_imagen">catalogo/recepcion/hero.webp</field>
            <field name="hero_intro"><![CDATA[
                <p class="o_ferba_hero__lead">El inicio de una línea postcosecha define la continuidad de todo el proceso.</p>
                <p class="o_ferba_hero__lead">En FERBA desarrollamos sistemas para recibir, descargar y alimentar frutas y hortalizas de forma controlada, permitiendo un flujo constante hacia las siguientes etapas de lavado, selección, calibrado y empaque.</p>
            ]]></field>
            <field name="narrativa_antetitulo">El inicio de una línea eficiente</field>
            <field name="narrativa_titulo">Una alimentación uniforme comienza desde la recepción</field>
            <field name="narrativa_intro"><![CDATA[
                <p>La recepción del producto es una etapa crítica dentro del proceso postcosecha. Una descarga adecuada ayuda a mantener un flujo continuo, reducir interrupciones y alimentar de manera ordenada los equipos posteriores.</p>
                <p>Por eso FERBA desarrolla diferentes sistemas de recepción según la forma en que llega el producto a la empacadora, ya sea en bins, cajas u otros sistemas de manejo.</p>
            ]]></field>
            <field name="factor_titulo">Factores que definen tu solución</field>
            <field name="cierre_titulo">¿Necesitas definir cómo recibir y alimentar tu producto?</field>
            <field name="cierre_texto">Cuéntanos qué producto procesas, qué capacidad necesitas y qué etapa quieres mejorar. Nuestro equipo puede ayudarte a definir si tu operación requiere una línea completa, modernización, automatización o un proyecto llave en mano.</field>
            <field name="meta_titulo">Recepción y alimentación de producto postcosecha | FERBA</field>
            <field name="meta_descripcion">Volcadores de bins y cajas, tanques de recepción y lavadoras para recibir, descargar y alimentar el producto al inicio de la línea postcosecha.</field>
        </record>
        <record id="flujo_rec_1" model="ferba.categoria.flujo"><field name="categoria_id" ref="cat_recepcion"/><field name="secuencia">10</field><field name="etiqueta">Contenedor</field></record>
        <record id="flujo_rec_2" model="ferba.categoria.flujo"><field name="categoria_id" ref="cat_recepcion"/><field name="secuencia">20</field><field name="etiqueta">Descarga</field></record>
        <record id="flujo_rec_3" model="ferba.categoria.flujo"><field name="categoria_id" ref="cat_recepcion"/><field name="secuencia">30</field><field name="etiqueta">Alimentación</field></record>
        <record id="factor_rec_1" model="ferba.categoria.factor"><field name="categoria_id" ref="cat_recepcion"/><field name="secuencia">10</field><field name="titulo">Tipo de contenedor</field><field name="texto">La solución se define según la forma en que el producto llega y es manejado dentro de la empacadora.</field></record>
        <record id="factor_rec_2" model="ferba.categoria.factor"><field name="categoria_id" ref="cat_recepcion"/><field name="secuencia">20</field><field name="titulo">Producto</field><field name="texto">El sistema debe considerar dimensiones, comportamiento y necesidades de manejo.</field></record>
        <record id="factor_rec_3" model="ferba.categoria.factor"><field name="categoria_id" ref="cat_recepcion"/><field name="secuencia">30</field><field name="titulo">Capacidad</field><field name="texto">La configuración se determina en función del volumen que debe alimentar la línea.</field></record>
        <record id="factor_rec_4" model="ferba.categoria.factor"><field name="categoria_id" ref="cat_recepcion"/><field name="secuencia">40</field><field name="titulo">Integración</field><field name="texto">Diseñamos la recepción considerando los equipos y etapas que continuarán después de la descarga.</field></record>

        <record id="maq_volcador_bins_rot" model="ferba.maquina"><field name="nombre">Volcador de bins rotativo</field><field name="slug">volcador-bins-rotativo</field><field name="categoria_id" ref="cat_recepcion"/><field name="secuencia">10</field><field name="chips">Bins, Descarga, Inicio de línea</field><field name="tarjeta_imagen">catalogo/recepcion/cards/volcador-bins-rotativo.webp</field><field name="hero_imagen">catalogo/recepcion/hero.webp</field></record>
        <record id="maq_volcador_cajas_tor" model="ferba.maquina"><field name="nombre">Volcador de cajas por torsión</field><field name="slug">volcador-cajas-torsion</field><field name="categoria_id" ref="cat_recepcion"/><field name="secuencia">20</field><field name="chips">Cajas, Flujo de producto, Torsión</field><field name="tarjeta_imagen">catalogo/recepcion/cards/volcador-cajas-torsion.webp</field><field name="hero_imagen">catalogo/recepcion/hero.webp</field></record>
        <record id="maq_volcador_cajas_rot" model="ferba.maquina"><field name="nombre">Volcador de cajas rotativo</field><field name="slug">volcador-cajas-rotativo</field><field name="categoria_id" ref="cat_recepcion"/><field name="secuencia">30</field><field name="chips">Cajas, Volteo rotativo, Alimentación</field><field name="tarjeta_imagen">catalogo/recepcion/cards/volcador-cajas-rotativo.webp</field><field name="hero_imagen">catalogo/recepcion/hero.webp</field></record>
        <record id="maq_tanque_recepcion" model="ferba.maquina"><field name="nombre">Tanque de recepción</field><field name="slug">tanque-recepcion</field><field name="categoria_id" ref="cat_recepcion"/><field name="secuencia">40</field><field name="chips">Recepción, Acumulación, Alimentación</field><field name="tarjeta_imagen">catalogo/recepcion/cards/tanque-recepcion.webp</field><field name="hero_imagen">catalogo/recepcion/hero.webp</field></record>
        <record id="maq_lavadora_cajas" model="ferba.maquina"><field name="nombre">Lavadora de cajas</field><field name="slug">lavadora-cajas</field><field name="categoria_id" ref="cat_recepcion"/><field name="secuencia">50</field><field name="chips">Cajas, Lavado, Reutilización</field><field name="tarjeta_imagen">catalogo/recepcion/cards/lavadora-cajas.webp</field><field name="hero_imagen">catalogo/recepcion/hero.webp</field></record>
        <record id="maq_lavadora_bins" model="ferba.maquina"><field name="nombre">Lavadora de bins</field><field name="slug">lavadora-bins</field><field name="categoria_id" ref="cat_recepcion"/><field name="secuencia">60</field><field name="chips">Bins, Limpieza, Reutilización</field><field name="tarjeta_imagen">catalogo/recepcion/cards/lavadora-bins.webp</field><field name="hero_imagen">catalogo/recepcion/hero.webp</field></record>

        <!-- ============================================================ -->
        <!-- LAVADO Y TRATAMIENTO                                         -->
        <!-- ============================================================ -->
        <record id="cat_lavado" model="ferba.categoria">
            <field name="nombre">Lavado y tratamiento</field>
            <field name="slug">lavado</field>
            <field name="secuencia">20</field>
            <field name="hero_titulo">Lavado y cribado para preparar el producto</field>
            <field name="hero_imagen">catalogo/lavado/hero.webp</field>
            <field name="hero_intro"><![CDATA[
                <p class="o_ferba_hero__lead">Una correcta etapa de cribado y lavado ayuda a preparar frutos y hortalizas para los procesos posteriores de selección y empaque.</p>
                <p class="o_ferba_hero__lead">En FERBA desarrollamos equipos para el lavado y manejo del producto dentro de la operación postcosecha.</p>
            ]]></field>
            <field name="narrativa_antetitulo">Preparar correctamente cada etapa</field>
            <field name="narrativa_titulo">Limpieza y preparación antes de continuar el proceso</field>
            <field name="narrativa_intro"><![CDATA[
                <p>El lavado forma parte de las primeras etapas de una línea postcosecha y permite retirar suciedad superficial y preparar el producto para procesos posteriores.</p>
            ]]></field>
            <field name="factor_titulo">Configuramos el lavado según tu proceso</field>
            <field name="cierre_titulo">¿Necesitas integrar lavado y cribas a tu operación?</field>
            <field name="cierre_texto">Cuéntanos qué producto procesas, qué capacidad necesitas y qué etapa quieres mejorar. Nuestro equipo puede ayudarte a definir si tu operación requiere una línea completa, modernización, automatización o un proyecto llave en mano.</field>
            <field name="meta_titulo">Lavado y cribado de producto postcosecha | FERBA</field>
            <field name="meta_descripcion">Cribas de rodillos y de malla, y unidades de cepillos de lavado para retirar suciedad superficial y preparar frutas y hortalizas antes de la selección.</field>
        </record>
        <record id="flujo_lav_1" model="ferba.categoria.flujo"><field name="categoria_id" ref="cat_lavado"/><field name="secuencia">10</field><field name="etiqueta">Producto recibido</field></record>
        <record id="flujo_lav_2" model="ferba.categoria.flujo"><field name="categoria_id" ref="cat_lavado"/><field name="secuencia">20</field><field name="etiqueta">Lavado y tratamiento</field></record>
        <record id="flujo_lav_3" model="ferba.categoria.flujo"><field name="categoria_id" ref="cat_lavado"/><field name="secuencia">30</field><field name="etiqueta">Producto preparado</field></record>
        <record id="factor_lav_1" model="ferba.categoria.factor"><field name="categoria_id" ref="cat_lavado"/><field name="secuencia">10</field><field name="titulo">Producto</field><field name="texto">La solución se define según aquello que debe ser tratado.</field></record>
        <record id="factor_lav_2" model="ferba.categoria.factor"><field name="categoria_id" ref="cat_lavado"/><field name="secuencia">20</field><field name="titulo">Capacidad requerida</field><field name="texto">Dimensionamos el sistema considerando el volumen de producto.</field></record>
        <record id="factor_lav_3" model="ferba.categoria.factor"><field name="categoria_id" ref="cat_lavado"/><field name="secuencia">30</field><field name="titulo">Integración en línea</field><field name="texto">Definimos entradas y salidas para conectar el equipo con las etapas anteriores y posteriores.</field></record>
        <record id="factor_lav_4" model="ferba.categoria.factor"><field name="categoria_id" ref="cat_lavado"/><field name="secuencia">40</field><field name="titulo">Configuración del proceso</field><field name="texto">Cada proyecto puede requerir diferentes tiempos, velocidades y configuraciones según las necesidades de operación.</field></record>

        <record id="maq_criba_rodillos" model="ferba.maquina"><field name="nombre">Criba de rodillos regulable</field><field name="slug">criba-rodillos-regulable</field><field name="categoria_id" ref="cat_lavado"/><field name="secuencia">10</field><field name="chips">Rodillos, Lavado continuo, Producto</field><field name="tarjeta_imagen">catalogo/lavado/cards/criba-rodillos-regulable.webp</field><field name="hero_imagen">catalogo/lavado/hero.webp</field></record>
        <record id="maq_cepillos_lavado" model="ferba.maquina"><field name="nombre">Unidad de cepillos de lavado</field><field name="slug">unidad-cepillos-lavado</field><field name="categoria_id" ref="cat_lavado"/><field name="secuencia">20</field><field name="chips">Rodillos, Lavado continuo, Producto</field><field name="tarjeta_imagen">catalogo/lavado/cards/unidad-cepillos-lavado.webp</field><field name="hero_imagen">catalogo/lavado/hero.webp</field></record>
        <record id="maq_criba_malla" model="ferba.maquina"><field name="nombre">Criba de malla descanicadora</field><field name="slug">criba-malla-descanicadora</field><field name="categoria_id" ref="cat_lavado"/><field name="secuencia">30</field><field name="chips">Malla, Producto, Proceso continuo</field><field name="tarjeta_imagen">catalogo/lavado/cards/criba-malla-descanicadora.webp</field><field name="hero_imagen">catalogo/lavado/hero.webp</field></record>

        <!-- ============================================================ -->
        <!-- SECADO Y CEPILLADO                                           -->
        <!-- ============================================================ -->
        <record id="cat_secado" model="ferba.categoria">
            <field name="nombre">Secado y cepillado</field>
            <field name="slug">secado</field>
            <field name="secuencia">30</field>
            <field name="hero_titulo">Secado y cepillado para preparar el producto</field>
            <field name="hero_imagen">catalogo/secado/hero.webp</field>
            <field name="hero_intro"><![CDATA[
                <p class="o_ferba_hero__lead">Después del lavado, el producto necesita continuar su preparación antes de pasar a selección y empaque.</p>
                <p class="o_ferba_hero__lead">En FERBA desarrollamos equipos para retirar humedad superficial y realizar procesos de cepillado y encerado, ayudando a mejorar la presentación del producto y mantener un flujo continuo dentro de la línea postcosecha.</p>
            ]]></field>
            <field name="narrativa_antetitulo">La transición después del lavado</field>
            <field name="narrativa_titulo">Preparar el producto para las siguientes etapas</field>
            <field name="narrativa_intro"><![CDATA[
                <p>Después del lavado, puede permanecer humedad superficial y condiciones que deben controlarse antes de continuar con la clasificación o el empaque.</p>
                <p>El secado y cepillado ayudan a preparar el producto para las siguientes etapas de la línea, manteniendo un proceso continuo y adaptado a las características de cada fruto.</p>
            ]]></field>
            <field name="factor_titulo">Adaptamos la preparación a tu proceso</field>
            <field name="cierre_titulo">¿Necesitas integrar secado o cepillado a tu línea?</field>
            <field name="cierre_texto">Cuéntanos qué producto procesas, qué capacidad necesitas y qué etapa quieres mejorar. Nuestro equipo puede ayudarte a definir si tu operación requiere una línea completa, modernización, automatización o un proyecto llave en mano.</field>
            <field name="meta_titulo">Secado y cepillado de producto postcosecha | FERBA</field>
            <field name="meta_descripcion">Unidades de cepillos de secado y encerado para retirar humedad superficial y mejorar la presentación del producto antes de la selección y el empaque.</field>
        </record>
        <record id="flujo_sec_1" model="ferba.categoria.flujo"><field name="categoria_id" ref="cat_secado"/><field name="secuencia">10</field><field name="etiqueta">Lavado</field></record>
        <record id="flujo_sec_2" model="ferba.categoria.flujo"><field name="categoria_id" ref="cat_secado"/><field name="secuencia">20</field><field name="etiqueta">Secado</field></record>
        <record id="flujo_sec_3" model="ferba.categoria.flujo"><field name="categoria_id" ref="cat_secado"/><field name="secuencia">30</field><field name="etiqueta">Cepillado / Encerado</field></record>
        <record id="flujo_sec_4" model="ferba.categoria.flujo"><field name="categoria_id" ref="cat_secado"/><field name="secuencia">40</field><field name="etiqueta">Selección</field></record>
        <record id="factor_sec_1" model="ferba.categoria.factor"><field name="categoria_id" ref="cat_secado"/><field name="secuencia">10</field><field name="titulo">Tipo de fruto</field><field name="texto">Dimensiones, forma y comportamiento del producto.</field></record>
        <record id="factor_sec_2" model="ferba.categoria.factor"><field name="categoria_id" ref="cat_secado"/><field name="secuencia">20</field><field name="titulo">Humedad</field><field name="texto">Condiciones de salida después del lavado.</field></record>
        <record id="factor_sec_3" model="ferba.categoria.factor"><field name="categoria_id" ref="cat_secado"/><field name="secuencia">30</field><field name="titulo">Capacidad</field><field name="texto">Volumen de producto que debe manejar la línea.</field></record>
        <record id="factor_sec_4" model="ferba.categoria.factor"><field name="categoria_id" ref="cat_secado"/><field name="secuencia">40</field><field name="titulo">Integración en la línea</field><field name="texto">Conexión con lavado, selección y empaque.</field></record>

