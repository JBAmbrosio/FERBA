<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================
         CONTENIDO M2 — las 5 categorías restantes de maquinaria
         (Recepción, Lavado, Secado, Transportadores, Selección) con sus
         equipos (tarjeta), y SEMBRADORAS como ficha completa "Línea de
         siembra" (su PDF es una ficha, no un listado).

         Copy e imágenes del diseño entregado por el cliente. Las fichas de
         las máquinas de estas categorías (salvo Línea de siembra) se
         poblarán después; por ahora llevan su tarjeta y la ficha muestra el
         stub "en preparación". Falta la categoría Automatización (el cliente
         no entregó su diseño).

         Nota: algunas miniaturas son mapeo best-guess (calibradores y
         transportadores son visualmente casi idénticos entre variantes);
         conviene una revisión rápida.
         ================================================================ -->
    <data>

        <!-- ============================================================ -->
        <!-- RECEPCIÓN Y ALIMENTACIÓN                                     -->
        <!-- ============================================================ -->
        <record id="cat_recepcion" model="ferba.categoria">
            <field name="nombre">Recepción y alimentación</field>
            <field name="slug">recepcion</field>
            <field name="secuencia">10</field>
            <field name="hero_titulo">Recepción y alimentación de producto</field>
            <field name="hero_imagen">catalogo/recepcion/hero.webp</field>
            <field name="hero_intro"><![CDATA[
                <p class="o_ferba_hero__lead">El inicio de una línea postcosecha define la continuidad de todo el proceso.</p>
                <p class="o_ferba_hero__lead">En FERBA desarrollamos sistemas para recibir, descargar y alimentar frutas y hortalizas de forma controlada, permitiendo un flujo constante hacia las siguientes etapas de lavado, selección, calibrado y empaque.</p>
            ]]></field>
            <field name="narrativa_antetitulo">El inicio de una línea eficiente</field>
            <field name="narrativa_titulo">Una alimentación uniforme comienza desde la recepción</field>
            <field name="narrativa_intro"><![CDATA[
                <p>La recepción del producto es una etapa crítica dentro del proceso postcosecha. Una descarga adecuada ayuda a mantener un flujo continuo, reducir interrupciones y alimentar de manera ordenada los equipos posteriores.</p>
                <p>Por eso FERBA desarrolla diferentes sistemas de recepción según la forma en que llega el producto a la empacadora, ya sea en bins, cajas u otros sistemas de manejo.</p>
                <p>Cada proyecto puede configurarse considerando el fruto, capacidad requerida, tipo de contenedor y características de la línea donde será integrado.</p>
            ]]></field>
            <field name="flujo_estilo">zigzag</field>
            <field name="equipos_antetitulo">Nuestros equipos</field>
            <field name="equipos_titulo">Equipos para recepción y alimentación</field>
            <field name="equipos_columnas">2</field>
            <field name="equipos_numerados" eval="False"/>
            <field name="flexquality" eval="False"/>
            <field name="extra_antetitulo" eval="False"/>
            <field name="extra_titulo" eval="False"/>
            <field name="factor_antetitulo">La recepción se adapta a tu operación</field>
            <field name="factor_titulo">Factores que definen tu solución</field>
            <field name="factor_tema">oscuro</field>
            <field name="cierre_titulo">¿Necesitas definir cómo recibir y alimentar tu producto?</field>
            <field name="cierre_texto">Cuéntanos qué producto procesas, qué capacidad necesitas y qué etapa quieres mejorar. Nuestro equipo puede ayudarte a definir si tu operación requiere una línea completa, modernización, automatización o un proyecto llave en mano.</field>
            <field name="meta_titulo">Recepción y alimentación de producto postcosecha | FERBA</field>
            <field name="meta_descripcion">Volcadores de bins y cajas, tanques de recepción y lavadoras para recibir, descargar y alimentar el producto al inicio de la línea postcosecha.</field>
        </record>
        <record id="flujo_rec_1" model="ferba.categoria.flujo"><field name="categoria_id" ref="cat_recepcion"/><field name="secuencia">10</field><field name="etiqueta">Contenedor</field><field name="subetiqueta">Bins o Cajas</field><field name="imagen">catalogo/recepcion/_cat/narr-1.webp</field></record>
        <record id="flujo_rec_2" model="ferba.categoria.flujo"><field name="categoria_id" ref="cat_recepcion"/><field name="secuencia">20</field><field name="etiqueta">Descarga</field><field name="subetiqueta">Volcado controlado</field><field name="imagen">catalogo/recepcion/_cat/narr-2.webp</field></record>
        <record id="flujo_rec_3" model="ferba.categoria.flujo"><field name="categoria_id" ref="cat_recepcion"/><field name="secuencia">30</field><field name="etiqueta">Alimentación</field><field name="subetiqueta">Flujo continuo a la línea</field><field name="imagen">catalogo/recepcion/_cat/narr-3.webp</field></record>
        <record id="factor_rec_1" model="ferba.categoria.factor"><field name="categoria_id" ref="cat_recepcion"/><field name="seccion">factor</field><field name="secuencia">10</field><field name="icono">catalogo/recepcion/_cat/factor-1.webp</field><field name="titulo">Tipo de contenedor</field><field name="subtitulo">Bins o cajas</field><field name="texto">La solución se define según la forma en que el producto llega y es manejado dentro de la empacadora.</field></record>
        <record id="factor_rec_2" model="ferba.categoria.factor"><field name="categoria_id" ref="cat_recepcion"/><field name="seccion">factor</field><field name="secuencia">20</field><field name="icono">catalogo/recepcion/_cat/factor-2.webp</field><field name="titulo">Producto</field><field name="subtitulo">Caracteristicas del fruto</field><field name="texto">El sistema debe considerar dimensiones, comportamiento y necesidades de manejo.</field></record>
        <record id="factor_rec_3" model="ferba.categoria.factor"><field name="categoria_id" ref="cat_recepcion"/><field name="seccion">factor</field><field name="secuencia">30</field><field name="icono">catalogo/recepcion/_cat/factor-3.webp</field><field name="titulo">Capacidad</field><field name="subtitulo">Flujo requerido</field><field name="texto">La configuración se determina en función del volumen que debe alimentar la línea.</field></record>
        <record id="factor_rec_4" model="ferba.categoria.factor"><field name="categoria_id" ref="cat_recepcion"/><field name="seccion">factor</field><field name="secuencia">40</field><field name="icono">catalogo/recepcion/_cat/factor-4.webp</field><field name="titulo">Integración</field><field name="subtitulo">Conexión con el proceso</field><field name="texto">Diseñamos la recepción considerando los equipos y etapas que continuarán después de la descarga.</field></record>

        <record id="maq_volcador_bins_rot" model="ferba.maquina"><field name="nombre">Volcador de bins rotativo</field><field name="slug">volcador-bins-rotativo</field><field name="categoria_id" ref="cat_recepcion"/><field name="secuencia">10</field><field name="chips">Bins, Descarga, Inicio de línea</field><field name="tarjeta_imagen">catalogo/recepcion/cards/volcador-bins-rotativo.webp</field><field name="hero_imagen">catalogo/recepcion/hero.webp</field><field name="tarjeta_texto">Sistema diseñado para descargar producto contenido en bins mediante un movimiento rotativo controlado, facilitando su incorporación al inicio de la línea postcosecha</field></record>
        <record id="maq_volcador_cajas_tor" model="ferba.maquina"><field name="nombre">Volcador de cajas por torsión</field><field name="slug">volcador-cajas-torsion</field><field name="categoria_id" ref="cat_recepcion"/><field name="secuencia">30</field><field name="chips">Cajas, Flujo de producto, Torsión</field><field name="tarjeta_imagen">catalogo/recepcion/cards/volcador-cajas-torsion.webp</field><field name="hero_imagen">catalogo/recepcion/hero.webp</field><field name="tarjeta_texto">Solución para descarga de cajas mediante un sistema de volteo por torsión, diseñada para transferir el producto hacia la línea de proceso de forma controlada</field></record>
        <record id="maq_volcador_cajas_rot" model="ferba.maquina"><field name="nombre">Volcador de cajas rotativo</field><field name="slug">volcador-cajas-rotativo</field><field name="categoria_id" ref="cat_recepcion"/><field name="secuencia">20</field><field name="chips">Cajas, Volteo rotativo, Alimentación</field><field name="tarjeta_imagen">catalogo/recepcion/cards/volcador-cajas-rotativo.webp</field><field name="hero_imagen">catalogo/recepcion/hero.webp</field><field name="tarjeta_texto">Equipo desarrollado para realizar la descarga de producto contenido en cajas mediante un sistema de volteo rotativo, permitiendo alimentar de forma continua las siguientes etapas.</field></record>
        <record id="maq_tanque_recepcion" model="ferba.maquina"><field name="nombre">Tanque de recepción</field><field name="slug">tanque-recepcion</field><field name="categoria_id" ref="cat_recepcion"/><field name="secuencia">40</field><field name="chips">Recepción, Acumulación, Alimentación</field><field name="tarjeta_imagen">catalogo/recepcion/cards/tanque-recepcion.webp</field><field name="hero_imagen">catalogo/recepcion/hero.webp</field><field name="tarjeta_texto">Sistema destinado a recibir el producto al inicio del proceso y facilitar su incorporación controlada a las etapas posteriores de la línea.</field></record>
