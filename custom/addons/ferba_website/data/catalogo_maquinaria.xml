        <record id="factor_tra_1" model="ferba.categoria.factor"><field name="categoria_id" ref="cat_transportadores"/><field name="secuencia">10</field><field name="titulo">Tipo de producto o carga</field><field name="texto">Fruta, hortalizas, cajas, bins u otros elementos.</field></record>
