        <record id="flujo_tra_2" model="ferba.categoria.flujo"><field name="categoria_id" ref="cat_transportadores"/><field name="secuencia">20</field><field name="etiqueta">Lavado y tratamiento</field></record>
        <record id="flujo_tra_3" model="ferba.categoria.flujo"><field name="categoria_id" ref="cat_transportadores"/><field name="secuencia">30</field><field name="etiqueta">Secado y cepillado</field></record>
        <record id="flujo_tra_4" model="ferba.categoria.flujo"><field name="categoria_id" ref="cat_transportadores"/><field name="secuencia">40</field><field name="etiqueta">Selección y calibrado</field></record>
        <record id="flujo_tra_5" model="ferba.categoria.flujo"><field name="categoria_id" ref="cat_transportadores"/><field name="secuencia">50</field><field name="etiqueta">Empaque</field></record>
