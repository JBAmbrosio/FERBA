#. module: ferba_website
#: model_terms:ir.ui.view,arch_db:ferba_website.pagina_quienes_somos
msgid ""
"En <strong>FERBA</strong> desarrollamos maquinaria y sistemas para cada etapa del\n"
"                                proceso postcosecha: recepción, lavado, secado, cepillado, transporte,\n"
"                                selección, empaque y automatización."
msgstr "At <strong>FERBA</strong> we develop machinery and systems for every stage of the postharvest process: receiving, washing, drying, brushing, conveying, sorting, packing and automation."

#. module: ferba_website
#: model_terms:ir.ui.view,arch_db:ferba_website.pagina_quienes_somos
msgid ""
"Combinamos experiencia industrial, conocimiento agrícola e innovación\n"
"                                tecnológica para entregar soluciones que mejoran la eficiencia operativa,\n"
