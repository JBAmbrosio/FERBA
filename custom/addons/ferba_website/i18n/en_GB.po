#. module: ferba_website
#: model_terms:ir.ui.view,arch_db:ferba_website.pagina_quienes_somos
msgid ""
"Nuestra presencia comercial refleja el crecimiento de una marca enfocada\n"
"                            en responder a las necesidades de empacadoras, productores y agroindustrias\n"
"                            que buscan tecnología confiable para sus procesos postcosecha."
msgstr "Our commercial presence reflects the growth of a company focused on answering the needs of packinghouses, growers and agribusinesses looking for reliable technology for their postharvest processes."

#. module: ferba_website
#: model_terms:ir.ui.view,arch_db:ferba_website.pagina_soluciones
msgid "Soluciones postcosecha<br/>diseñadas para tu operación"
msgstr "Postharvest solutions<br/>designed for your operation"

#. module: ferba_website
#: model_terms:ir.ui.view,arch_db:ferba_website.pagina_soluciones
msgid ""
"Integramos maquinaria, automatizaciones y tecnología para mejorar el flujo,\n"
"                    la eficiencia y la calidad en líneas de frutas y hortalizas."
msgstr "We integrate machinery, automation and technology to improve the flow, the efficiency and the quality of fruit and vegetable lines."

#. module: ferba_website
#: model_terms:ir.ui.view,arch_db:ferba_website.pagina_soluciones
msgid ""
"Desde líneas completas hasta modernización de equipos existentes, en FERBA\n"
"                    desarrollamos soluciones adaptadas al producto, capacidad, espacio y objetivos\n"
"                    de cada cliente."
msgstr "From complete lines to upgrades of existing equipment, at FERBA we develop solutions matched to each customer's product, capacity, space and objectives."

#. module: ferba_website
#: model_terms:ir.ui.view,arch_db:ferba_website.pagina_soluciones
