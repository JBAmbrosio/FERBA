msgstr "Postharvest engineering<br/>with an international outlook"

#. module: ferba_website
#: model_terms:ir.ui.view,arch_db:ferba_website.pagina_quienes_somos
msgid ""
"<strong>FERBA</strong> es una marca especializada en el diseño, fabricación\n"
"                    e integración de maquinaria agroindustrial para procesos postcosecha.\n"
"                    Con raíces españolas y más de 20 años de enfoque en innovación tecnológica,\n"
"                    desarrollamos soluciones para empacadoras que buscan mejor eficiencia,\n"
"                    precisión y calidad."
msgstr "<strong>FERBA</strong> is a company specialized in the design, manufacture and integration of agro-industrial machinery for postharvest processes. With Spanish roots and more than 20 years focused on technological innovation, we develop solutions for packinghouses seeking better efficiency, accuracy and quality."

#. module: ferba_website
#: model_terms:ir.ui.view,arch_db:ferba_website.pagina_quienes_somos
msgid "<span>Presencia comercial en Estados Unidos, España, México y Perú</span>"
msgstr "<span>Commercial presence in the United States, Spain, Mexico and Peru</span>"

#. module: ferba_website
#: model_terms:ir.ui.view,arch_db:ferba_website.pagina_quienes_somos
msgid "Construyamos una línea<br/>más eficiente para tu operación"
