#. module: ferba_website
#: model_terms:ir.ui.view,arch_db:ferba_website.pagina_contacto
msgid ""
"Estamos ubicados en Culiacán, Sinaloa, México, desde donde atendemos proyectos\n"
"                                para empacadoras, productores y agroindustrias que buscan soluciones postcosecha\n"
"                                confiables, eficientes y adaptadas a su operación."
msgstr "We are based in Culiacán, Sinaloa, Mexico, and from there we serve projects for packinghouses, growers and agribusinesses looking for reliable, efficient postharvest solutions that fit their operation."

#. module: ferba_website
#: model_terms:ir.ui.view,arch_db:ferba_website.pagina_contacto
msgid "Mapa con la ubicación de FERBA en Culiacán, Sinaloa"
msgstr "Map showing the location of FERBA in Culiacán, Sinaloa"

