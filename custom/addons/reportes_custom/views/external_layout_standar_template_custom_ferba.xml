<?xml version="1.0" encoding="utf-8" ?>

<odoo>
    <record id="external_layout_standar_custom" model="ir.ui.view">
        <field name="name">external_layout_standard_custom</field>
        <field name="inherit_id" ref="web.external_layout_standard"/>
        <field name="arch" type="xml">

            <xpath expr="//div[contains(@t-attf-class,'header')]//div[contains(@class,'row')]" position="attributes">
                <attribute name="t-if">false</attribute>
            </xpath>
            
            
           
    
            <!--Encabezado de reporte saleorder ferba customizado incluye pleca header infomacion del parner y direccion del partner-->
            <xpath expr="//div[contains(@t-attf-class,'header')]" position="inside">

                <t t-foreach="env['x_reporte'].search([], limit=1)" t-as="obj_product">

                    <!-- Imagen header -->
                    <div class="row" style="text-align:right;">
                        <img t-if="obj_product.x_studio_header" t-att-src="image_data_uri(obj_product.x_studio_header)" style="width:80%; max-height:120px; object-fit:contain;" alt="pleca header"/>
                    </div>

                    <!-- Bloque principal -->
                    <div class="row">

                        <!-- Logo -->
                        <div class="col-5">
                            <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height:80px; width:auto;" alt="Logo"/>
                        </div>

                        <!-- Datos -->
                        <div class="col-7" style="text-align:right; line-height: 1; font-size:12px; margin-top:0px; margin-bottom:0px;">

                            <p style="text-align:right; line-height: 1; font-size:12px; margin-top:0px; margin-bottom:0px;" t-esc="obj_product.x_studio_compaia"/>
                            <p style="text-align:right; line-height: 1; font-size:12px; margin-top:0px; margin-bottom:0px;" t-esc="obj_product.x_studio_direccin"/>
                            <p style="text-align:right; line-height: 1; font-size:12px; margin-top:0px; margin-bottom:0px;" t-esc="obj_product.x_studio_estado"/>

                            <p style="text-align:right; line-height: 1; font-size:12px; margin-top:0px; margin-bottom:0px;"><b>RFC:</b> <span t-esc="obj_product.x_studio_rfc"/></p>

                            <!--Se valida que el objeto sea la orden de vent
                            <t t-if="doc and getattr(doc, '_name', '') == 'sale.order'">
                                    <p style="text-align:right; line-height: 1; font-size:12px; margin-top:0px; margin-bottom:0px;">
                                        <b>Fecha:</b> 
                                        <span t-if="doc._name == 'sale.order' and doc.date_order" 
                                                    t-esc="str(doc.date_order)[:10]""")/>
                                    </p>
                                    <p t-if="getattr(doc, 'validity_date', False)" style="text-align:right; line-height: 1; font-size:12px; margin-top:0px; margin-bottom:0px;">
                                        <b>Vencimiento:</b> 
                                        
                                        <span t-if="doc._name == 'sale.order' and doc.validity_date" 
                                                    t-esc="str(doc.validity_date)[:10]""")/>
                                    </p>
                                </t>
                                a-->
                            

                        </div>

                    </div>

                </t>
                
                <!--Se valida que el objeto sea la orden de venta-->
                <t>
                    <!--Columna Fecha, Moneda, RFC--> 
                    <div class="row" style="border:none;">
                        <div class="col-12" style="text-align:left; font-size:12px !important;">
                        <!--
                            <div class="row">
                                <div class="col-4">
                                <p t-if="doc and getattr(doc, 'partner_id', False)" style="line-height: 1; font-size:12px; margin:0;" t-esc="doc.partner_id.name"/>
                                </div>
                            </div>
                                
                            <div class="row">
                                <div class="col-4">
                                    <p style="line-height: 1;  font-size:12px;  margin:0; " t-if="doc.x_studio_direc" t-esc="doc.x_studio_direc"/>
                                </div>
                            </div>
                                    
                            <div class="row">
                                <div class="col-4">
                                    <p style="line-height: 1; margin:0; font-size:12px;  font-weight:bold;" t-if="doc.x_studio_rfc_cliente" t-esc="doc.x_studio_rfc_cliente"/>
                                
                                </div>
                            </div>
                            
                            <div class="row">
                                <div class="col-4">
                                    <p style="font-weight:bold; margin:0; font-size:12px;"> 
                                        Moneda:  <span style="line-height: 1; margin-top:0px; margin-bottom:0px; font-weight:bold; font-size:10px;" t-if="doc.currency_id" t-esc="doc.currency_id"/>
                                    </p> 
                                </div>
                            </div>
                                    -->
                        </div>
                    </div>
                    <!--Columna Fecha, Moneda, RFC-->
                </t>
                
            </xpath>
    

    
            <!--oculta el elemento footer nativo de saleorder-->
            <xpath expr="//div[contains(@t-attf-class,'footer')]//div" position="attributes">
                <attribute name="t-if">false</attribute>
                
            </xpath>
    
            <!--Pie de pagina reporte customizado FERBA-->
            <xpath expr="//div[contains(@t-attf-class,'footer')]" position="inside">
                

                <t t-foreach="request.env['x_reporte'].sudo().search([])" t-as="obj_reporte">
                    <img style=" width: 100%; height: auto; position:absolute;" t-att-src="image_data_uri(obj_reporte.x_studio_imagen_pie_de_pagina_1)" alt="header"/> 
                        <div class="row" style="position:relative; top:70px;">
                            
                            <div class="col-4 text-center" style="margin-left:20px !important; font-size:11px !important;  color:#ffffff; padding-top:20px !important;">
                                <p> 
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-telephone-fill" viewBox="0 0 16 16">
                                        <path fill-rule="evenodd" d="M1.885.511a1.745 1.745 0 0 1 2.61.163L6.29 2.98c.329.423.445.974.315 1.494l-.547 2.19a.68.68 0 0 0 .178.643l2.457 2.457a.68.68 0 0 0 .644.178l2.189-.547a1.75 1.75 0 0 1 1.494.315l2.306 1.794c.829.645.905 1.87.163 2.611l-1.034 1.034c-.74.74-1.846 1.065-2.877.702a18.6 18.6 0 0 1-7.01-4.42 18.6 18.6 0 0 1-4.42-7.009c-.362-1.03-.037-2.137.703-2.877z"/>
                                    </svg>
                                    <span style="margin:0 !important;  font-weight:bold; padding-top:14px !important; " t-esc="obj_reporte.x_studio_tel_1"/>
                                        /
                                    <span style="margin:0 !important;  font-weight:bold; padding-top:14px !important; " t-esc="obj_reporte.x_studio_tel_2"/>
                                </p>
                            </div> 

                            <div class="col-2 text-center" style=" color:#ffffff; padding:20px 2px 0 2px !important; font-size:10px !important; ">
                                <p>
                                
                                    <i class="fa fa-globe" style="font-size: 16px; color: white;"/>
                                
                                    <span style="margin:0 !important; padding-top:11px !important; " t-esc="obj_reporte.x_studio_sitio_web"/>
                                </p>
                            </div>
                                        
                            <div class="col-3 text-center " style=" color:#ffffff; text-align: left; padding-top:20px !important; font-size:11px !important; ">
                        
                                <p>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-envelope" viewBox="0 0 16 16">
                                        <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1zm13 2.383-4.708 2.825L15 11.105zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741M1 11.105l4.708-2.897L1 5.383z"/>
                                    </svg>

                                    <span style="margin:0 !important;  font-weight:bold; padding-top:11px !important; " t-esc="obj_reporte.x_studio_correo"/>
                                </p>
                            </div>
                                
                            <div class="col-2 text-center" style="display:none;">
                                <span t-if="obj_reporte.x_studio_imagen_pie_de_pagina_1">
                                    <div style=" width:100%; heigth: 100%; margin:0 !important; padding:0 !important; " class="col-2"/>
                                </span>
                            </div>

                            <div class=" col-3 text-center" style="color:black;" t-if="report_type == 'pdf'">Page: <span class="page"/> / <span class="topage"/>
                        </div>
                    </div>
                </t>
                        
                <ul style="display:none;" class="list-inline mb4">
                    <div t-field="company.report_footer"/>
                </ul>
                
            </xpath>
 
        </field>
    </record>

</odoo>