<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="foco_monitor.Vendedores">
        <div class="foco_vend" t-att-class="{ 'fv-dark': state.dark }">

            <header class="fv_head">
                <div class="fv_head_l">
                    <h1>Vendedores</h1>
                    <p class="fv_sub" t-if="!state.loading">
                        <span t-esc="state.kpis.total || 0"/> clientes
                        <t t-if="state.kpis.sin_geo">
                            <span class="sep">·</span>
                            <span class="fv_aviso"><i class="fa fa-map-marker"/> <t t-esc="state.kpis.sin_geo"/> sin ubicacion</span>
                        </t>
                        <t t-if="state.ultimo"><span class="sep">·</span> actualizado <t t-esc="horaUltimo()"/></t>
                    </p>
                </div>
                <button class="fv_refrescar" t-on-click="() => this.refrescar()" title="Actualizar ahora">
                    <i class="fa fa-refresh"/><span>Actualizar</span>
                </button>
            </header>

            <!-- KPIs -->
            <section class="fv_kpis">
                <div class="fv_kpi">
                    <div class="fv_kpi_label">Clientes</div>
                    <div class="fv_kpi_v"><t t-esc="state.kpis.total || 0"/></div>
                </div>
                <div class="fv_kpi">
                    <div class="fv_kpi_label">Oportunidades</div>
                    <div class="fv_kpi_v"><t t-esc="state.kpis.oportunidades || 0"/></div>
                </div>
                <div class="fv_kpi">
                    <div class="fv_kpi_label">Visitas del mes</div>
                    <div class="fv_kpi_v"><t t-esc="state.kpis.visitas_mes || 0"/></div>
                </div>
                <div class="fv_kpi fv_kpi_warn">
                    <div class="fv_kpi_label">Sin visita (30 d)</div>
                    <div class="fv_kpi_v"><t t-esc="state.kpis.sin_visita_30 || 0"/></div>
                </div>
            </section>

            <!-- Filtros -->
            <section class="fv_filtros">
                <select t-on-change="(ev) => this.setFiltro('vendedor', ev)">
                    <option value="">Todos los vendedores</option>
                    <t t-foreach="state.cat.vendedores" t-as="v" t-key="v.id">
                        <option t-att-value="v.id" t-att-selected="String(state.f.vendedor) === String(v.id)" t-esc="v.name"/>
                    </t>
                </select>
                <select t-on-change="(ev) => this.setFiltro('zona', ev)">
                    <option value="">Todas las zonas</option>
                    <t t-foreach="state.cat.zonas" t-as="z" t-key="z">
                        <option t-att-value="z" t-att-selected="state.f.zona === z" t-esc="z"/>
                    </t>
                </select>
                <select t-on-change="(ev) => this.setFiltro('cultivo', ev)">
                    <option value="">Todos los cultivos</option>
                    <t t-foreach="state.cat.cultivos" t-as="cu" t-key="cu">
                        <option t-att-value="cu" t-att-selected="state.f.cultivo === cu" t-esc="cu"/>
                    </t>
                </select>
                <select t-on-change="(ev) => this.setFiltro('estatus', ev)">
                    <option value="">Todos los estatus</option>
                    <t t-foreach="state.cat.estatus" t-as="e" t-key="e.k">
                        <option t-att-value="e.k" t-att-selected="state.f.estatus === e.k" t-esc="e.v"/>
                    </t>
                </select>
                <button class="fv_limpiar" t-if="hayFiltros" t-on-click="() => this.limpiar()">
                    <i class="fa fa-times"/> Limpiar
                </button>
            </section>

            <!-- Mapa + panel -->
            <section class="fv_main">
                <div class="fv_map_card">
                    <div class="fv_map" t-ref="map"/>
                    <div class="fv_legend">
                        <t t-foreach="state.cat.estatus" t-as="e" t-key="e.k">
                            <span class="fv_leg">
                                <span class="fv_dot" t-attf-style="background: {{ estColor(e.k) }}"/>
                                <t t-esc="e.v"/> <b><t t-esc="kpiEstatus(e.k)"/></b>
                            </span>
                        </t>
                    </div>
                </div>

                <aside class="fv_side">
                    <!-- Ficha del cliente seleccionado -->
                    <div class="fv_ficha" t-if="state.sel">
                        <div class="fv_ficha_head">
                            <div>
                                <span class="fv_dot" t-attf-style="background: {{ state.sel.color }}"/>
                                <b t-esc="state.sel.name"/>
                                <div class="fv_ficha_est" t-esc="estLabel(state.sel.estatus)"/>
                            </div>
                            <button class="fv_x" t-on-click="() => this.cerrarFicha()"><i class="fa fa-times"/></button>
                        </div>

                        <div class="fv_ficha_meta">
                            <div t-if="state.sel.empaque"><i class="fa fa-industry"/> <t t-esc="state.sel.empaque"/></div>
                            <div t-if="state.sel.contacto"><i class="fa fa-user"/> <t t-esc="state.sel.contacto"/></div>
                            <div t-if="state.sel.zona"><i class="fa fa-map-o"/> <t t-esc="state.sel.zona"/></div>
                            <div t-if="state.sel.cultivo"><i class="fa fa-leaf"/> <t t-esc="state.sel.cultivo"/></div>
                            <div t-if="state.sel.vendedor"><i class="fa fa-briefcase"/> <t t-esc="state.sel.vendedor"/></div>
                            <div t-if="state.sel.ubicacion_fisica" class="fv_muted"><i class="fa fa-location-arrow"/> <t t-esc="state.sel.ubicacion_fisica"/></div>
                        </div>

                        <div class="fv_acciones">
                            <a t-if="state.sel.phone" class="fv_btn" t-att-href="telLink(state.sel.phone)"><i class="fa fa-phone"/> Llamar</a>
                            <a t-if="state.sel.phone" class="fv_btn fv_wa" t-att-href="waLink(state.sel.phone)" target="_blank"><i class="fa fa-whatsapp"/> WhatsApp</a>
                            <a t-if="state.sel.lat || state.sel.lng" class="fv_btn" t-att-href="comoLlegar(state.sel)" target="_blank"><i class="fa fa-location-arrow"/> Como llegar</a>
                            <a t-if="state.sel.expediente" class="fv_btn" t-att-href="state.sel.expediente" target="_blank"><i class="fa fa-folder-open"/> Expediente</a>
                            <button class="fv_btn fv_ghost" t-on-click="() => this.abrirCliente(state.sel)"><i class="fa fa-external-link"/> Abrir en Odoo</button>
                        </div>

                        <div class="fv_oport" t-if="state.sel.oportunidades.length">
                            <h3>Oportunidades</h3>
                            <t t-foreach="state.sel.oportunidades" t-as="op" t-key="op.id">
                                <div class="fv_op" t-on-click="() => this.abrirOportunidad(op)">
                                    <div class="fv_op_n" t-esc="op.name"/>
                                    <div class="fv_op_meta">
                                        <span t-if="op.stage" class="fv_chip" t-esc="op.stage"/>
                                        <span t-if="op.revenue" class="fv_op_rev" t-esc="dinero(op.revenue)"/>
                                        <span t-if="op.deadline" class="fv_muted"><i class="fa fa-clock-o"/> <t t-esc="op.deadline"/></span>
                                    </div>
                                </div>
                            </t>
                        </div>

                        <div class="fv_visitas_info">
                            <t t-if="state.sel.ultima_visita">
                                <i class="fa fa-check-circle"/> Ultima visita: <t t-esc="fechaCorta(state.sel.ultima_visita)"/>
                                (<t t-esc="state.sel.n_visitas"/>)
                            </t>
                            <t t-else="">
                                <i class="fa fa-circle-o"/> Sin visitas registradas
                            </t>
                        </div>
                    </div>

                    <!-- Lista de clientes (cuando no hay ficha abierta) -->
                    <div class="fv_lista" t-else="">
                        <div class="fv_lista_head">Clientes <span t-esc="state.clientes.length"/></div>
                        <t t-foreach="state.clientes" t-as="c" t-key="c.id">
                            <div class="fv_row" t-on-click="() => this.seleccionar(c)">
                                <span class="fv_dot" t-attf-style="background: {{ c.color }}"/>
                                <div class="fv_row_txt">
                                    <div class="fv_row_n" t-esc="c.name"/>
                                    <div class="fv_row_m">
                                        <t t-if="c.zona"><t t-esc="c.zona"/></t>
                                        <t t-if="c.cultivo"> · <t t-esc="c.cultivo"/></t>
                                        <t t-if="!c.lat and !c.lng"> · <span class="fv_aviso">sin ubicacion</span></t>
                                    </div>
                                </div>
                                <span class="fv_row_op" t-if="c.oportunidades.length" t-attf-title="{{ c.oportunidades.length }} oportunidad(es)">
                                    <i class="fa fa-bolt"/> <t t-esc="c.oportunidades.length"/>
                                </span>
                            </div>
                        </t>
                        <p class="fv_empty" t-if="!state.loading and !state.clientes.length">
                            No hay clientes con estos filtros.
                        </p>
                    </div>
                </aside>
            </section>

            <div class="fv_loading" t-if="state.loading">Cargando…</div>
        </div>
    </t>
</templates>
