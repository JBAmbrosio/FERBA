<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="foco_monitor.Play">
        <div class="fp_wrap">
            <header class="fp_head">
                <div class="fp_titulos">
                    <h1>Play Store de la empresa</h1>
                    <p t-if="state.destino" t-esc="state.destino"/>
                    <p t-elif="!state.error">Busca una app y elígela para aprobarla.</p>
                </div>
                <div class="fp_elegidas" t-if="state.elegidas.length">
                    <t t-foreach="state.elegidas.slice(0, 3)" t-as="e" t-key="e.paquete + e_index">
                        <span class="fp_chip" t-att-title="e.mensaje" t-esc="e.paquete"/>
                    </t>
                </div>
            </header>

            <!-- Falta configurar: se dice que, y a donde ir. Una pantalla en
                 blanco con un iframe roto no le dice nada a nadie. -->
            <section class="fp_aviso" t-if="state.error">
                <h2>Todavía no se puede abrir</h2>
                <p t-esc="state.error"/>
                <p class="fp_pasos" t-if="state.estado">
                    La Play Store administrada existe cuando la empresa está registrada en
                    Android Enterprise: cuenta de servicio de Google, y luego «Registrar la
                    empresa en Google». Todo está en Configuración › Monitoreo móvil.
                </p>
                <button class="btn btn-primary" t-on-click="() => this.abrirAjustes()">
                    Ir a la configuración
                </button>
            </section>

            <div class="fp_marco" t-ref="marco" t-att-class="{ 'fp_oculto': state.error }">
                <div class="fp_cargando" t-if="state.cargando and !state.error">
                    <span class="fp_barra"/>
                    <span>Abriendo la Play Store…</span>
                </div>
            </div>
        </div>
    </t>
</templates>
