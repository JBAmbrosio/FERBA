<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Rehace los hechos de los ultimos dos dias por si algo llego tarde
             (un envio puede cruzar la medianoche). Lo de hoy se rehace ademas
             con cada envio del agente, asi que esto es la red de seguridad. -->
        <record id="cron_foco_integrity" model="ir.cron">
            <field name="name">Foco: hechos de integridad (ultimos dos dias)</field>
            <field name="model_id" ref="model_foco_integrity_fact"/>
            <field name="state">code</field>
            <field name="code">model._cron_rebuild(2)</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
