<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Analiza las llamadas de WhatsApp que el telefono dejo pendientes:
         transcribe + coaching (misma rubrica que las visitas). -->
    <record id="cron_foco_analizar_llamadas" model="ir.cron">
        <field name="name">Foco: analizar llamadas de WhatsApp (coaching)</field>
        <field name="model_id" ref="model_foco_llamada"/>
        <field name="state">code</field>
        <field name="code">model._cron_analizar_llamadas()</field>
        <field name="interval_number">2</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
