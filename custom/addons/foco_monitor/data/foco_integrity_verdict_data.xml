<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cierra los episodios que el agente dejo abiertos, analiza los que
             esperan veredicto y reintenta los que fallaron. Cada 5 min: un
             episodio sin veredicto es un renglon gris, no una urgencia. -->
        <record id="cron_foco_integrity_verdict" model="ir.cron">
            <field name="name">Foco: episodios sospechosos pendientes de veredicto</field>
            <field name="model_id" ref="model_foco_integrity_verdict"/>
            <field name="state">code</field>
            <field name="code">model._cron_pendientes()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
