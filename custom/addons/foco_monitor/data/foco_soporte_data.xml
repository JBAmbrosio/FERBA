<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Respaldo del soporte TI: si infra olvido desactivarlo, se apaga al
             CIERRE DE LA JORNADA de la empresa del equipo (hora local,
             configurable en Ventana de inactividad -> "Apagar soporte TI a las")
             y la proteccion vuelve esa noche. Cada media hora: cierra solo lo
             que ya paso su hora de cierre. -->
        <record id="cron_foco_soporte_respaldo" model="ir.cron">
            <field name="name">Foco: apagar soporte TI olvidado (cierre de jornada)</field>
            <field name="model_id" ref="model_foco_computer"/>
            <field name="state">code</field>
            <field name="code">model._cron_cerrar_soporte_vencido()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
