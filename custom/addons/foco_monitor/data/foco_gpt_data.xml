<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Clasifica las conversaciones de Tommy GPT tocadas desde la ultima
         corrida (trabajo / distraccion / mixta / indeterminada). Va por cron,
         no en el chat, para no encarecerlo ni frenarlo: la etiqueta es para el
         administrador. -->
    <record id="cron_foco_gpt_clasifica" model="ir.cron">
        <field name="name">Foco: clasificar conversaciones de Tommy GPT</field>
        <field name="model_id" ref="foco_monitor.model_foco_gpt_thread"/>
        <field name="state">code</field>
        <field name="code">model._cron_clasificar()</field>
        <field name="interval_number">20</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
