<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Analiza con IA las visitas cuyo audio ya llego y esta pendiente. -->
    <record id="cron_foco_visita_analisis" model="ir.cron">
        <field name="name">Foco: analizar visitas grabadas (IA)</field>
        <field name="model_id" ref="model_foco_visita"/>
        <field name="state">code</field>
        <field name="code">model._cron_analizar_visitas()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
