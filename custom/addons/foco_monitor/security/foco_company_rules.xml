<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        FOCO POR EMPRESA (15-oct-2026).

        Cada registro de Foco es de la EMPRESA DE SU EMPLEADO, y se ve solo con
        esa empresa activa en el selector: me pongo en Peru y veo a los de Peru.
        Por eso la regla va sobre `employee_id.company_id` y no sobre un campo
        propio: cuando una persona cambia de empresa (Claudia, de Industrias a
        Peru) su historia se va con ella, sin mover un solo registro.

        Son reglas GLOBALES (sin grupo): Odoo las combina con AND con las de
        alcance por departamento (foco_record_rules.xml), asi que el alcance por
        departamento sigue funcionando dentro de cada empresa. Lo que corre con
        sudo -los agentes, los telefonos, los procesos automaticos- no las ve;
        lo que ve una persona en pantalla, si.

        Un registro sin empleado (un equipo aun sin asignar) se ve en todas.
    -->
    <record id="rule_empresa_foco_usage" model="ir.rule">
        <field name="name">Foco por empresa: uso</field>
        <field name="model_id" ref="model_foco_usage"/>
        <field name="domain_force">['|', ('employee_id', '=', False), ('employee_id.company_id', 'in', company_ids)]</field>
    </record>
