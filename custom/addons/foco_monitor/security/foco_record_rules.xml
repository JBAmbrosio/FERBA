    </record>
    <record id="rule_foco_mobile_device_alcance" model="ir.rule">
        <field name="name">Foco: dispositivos del alcance asignado</field>
        <field name="model_id" ref="model_foco_mobile_device"/>
        <field name="groups" eval="[(4, ref('group_foco_user'))]"/>
        <field name="domain_force">[('department_id', 'in', user.foco_department_ids.ids)] if user.foco_department_ids else [(1, '=', 1)]</field>
    </record>

    <record id="rule_foco_location_admin" model="ir.rule">
        <field name="name">Foco: ubicaciones, los administradores ven todo</field>
        <field name="model_id" ref="model_foco_location"/>
        <field name="groups" eval="[(4, ref('group_foco_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_foco_location_alcance" model="ir.rule">
        <field name="name">Foco: ubicaciones del alcance asignado</field>
        <field name="model_id" ref="model_foco_location"/>
        <field name="groups" eval="[(4, ref('group_foco_user'))]"/>
        <field name="domain_force">[('employee_id.department_id', 'in', user.foco_department_ids.ids)] if user.foco_department_ids else [(1, '=', 1)]</field>
    </record>

    <record id="rule_foco_mobile_usage_admin" model="ir.rule">
        <field name="name">Foco: uso movil, los administradores ven todo</field>
        <field name="model_id" ref="model_foco_mobile_usage"/>
        <field name="groups" eval="[(4, ref('group_foco_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_foco_mobile_usage_alcance" model="ir.rule">
        <field name="name">Foco: uso movil del alcance asignado</field>
        <field name="model_id" ref="model_foco_mobile_usage"/>
        <field name="groups" eval="[(4, ref('group_foco_user'))]"/>
        <field name="domain_force">[('employee_id.department_id', 'in', user.foco_department_ids.ids)] if user.foco_department_ids else [(1, '=', 1)]</field>
    </record>

    <record id="rule_foco_call_admin" model="ir.rule">
        <field name="name">Foco: llamadas, los administradores ven todo</field>
        <field name="model_id" ref="model_foco_call"/>
        <field name="groups" eval="[(4, ref('group_foco_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_foco_call_alcance" model="ir.rule">
        <field name="name">Foco: llamadas del alcance asignado</field>
        <field name="model_id" ref="model_foco_call"/>
        <field name="groups" eval="[(4, ref('group_foco_user'))]"/>
        <field name="domain_force">[('employee_id.department_id', 'in', user.foco_department_ids.ids)] if user.foco_department_ids else [(1, '=', 1)]</field>
    </record>
</odoo>
