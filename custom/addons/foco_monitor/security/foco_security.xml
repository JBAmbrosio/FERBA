<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_foco_user" model="res.groups">
        <field name="name">Foco / Consulta</field>
        <field name="comment">Puede ver equipos, uso y reportes de productividad.</field>
        <!-- Foco es una aplicacion interna: quien la consulta es personal de la
             empresa. Sin esta linea, un usuario al que solo se le da acceso a
             Foco no puede ni leer la ficha de otro usuario, y la pantalla de
             alcance le truena con un error de permisos que no explica nada. -->
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_foco_manager" model="res.groups">
        <field name="name">Foco / Administrador</field>
        <field name="comment">Clasifica apps, configura categorias, envia ordenes de control remoto y decide quien tiene acceso.</field>
        <!-- Administrar implica poder ver. Sin esta linea, restringir el menu
             raiz al grupo de consulta dejaria fuera al propio administrador. -->
        <field name="implied_ids" eval="[(4, ref('group_foco_user'))]"/>
    </record>

    <!-- Perfil de RECURSOS HUMANOS (reunion del 14-oct-2026): revisa la
         asistencia, los periodos sin actividad y las justificaciones, y NADA
         mas. A proposito NO implica el grupo de consulta: el que vea todo
         seria ese. Sus menus, vistas, permisos y reglas son suyos (ver
         foco_menus.xml, ir.model.access.csv y foco_record_rules.xml). -->
    <record id="group_foco_rrhh" model="res.groups">
        <field name="name">Foco / Recursos Humanos</field>
        <field name="comment">Ve solo la asistencia, los periodos sin actividad y las justificaciones, y decide sobre ellas. No ve el uso de apps, los equipos ni nada mas de Foco.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('group_foco_manager'))]"/>
    </record>

    <!-- Rol de VENDEDOR con las apps acotadas. Es un marcador: a quien lo tenga,
         Foco le oculta un conjunto de apps (Aplicaciones, Sitio web, Aprobaciones,
         Mantenimiento, Empleados) SIN tocar a los demas usuarios. Odoo no permite
         "ocultar un menu a un grupo" de forma nativa (groups_id es positivo), por
         eso se filtra en el override de ir.ui.menu._visible_menu_ids. El admin lo
         asigna a cada vendedor. -->
    <record id="group_foco_vendedor_acotado" model="res.groups">
        <field name="name">Foco / Vendedor (apps acotadas)</field>
        <field name="comment">Asignalo a los vendedores: les oculta Aplicaciones, Sitio web, Aprobaciones, Mantenimiento y Empleados, sin afectar a nadie mas.</field>
    </record>
</odoo>
