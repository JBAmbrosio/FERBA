<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- La pantalla principal de la jornada es la CINTA: una vista OWL propia,
         porque la pregunta que contesta es "cuando" y ninguna vista de lista o
         de grafico dibuja el tiempo como un lugar. La lista de abajo queda
         para exportar y para filtrar en grande. -->
    <record id="foco_jornada_client" model="ir.actions.client">
        <field name="name">Jornada</field>
        <field name="tag">foco_jornada</field>
    </record>

    <record id="foco_workday_view_list" model="ir.ui.view">
        <field name="name">foco.workday.list</field>
        <field name="model">foco.workday</field>
        <field name="arch" type="xml">
            <list string="Jornadas" create="0" delete="0" edit="0">
                <field name="date"/>
                <field name="employee_id"/>
                <field name="department_id" optional="show"/>
                <field name="first_signal" string="Primera senal" widget="datetime"/>
                <field name="last_signal" string="Ultima senal" widget="datetime"/>
                <field name="span_hours" string="De la primera a la ultima" widget="float_time"/>
                <field name="active_hours" widget="float_time" sum="Activo"/>
                <field name="shift_source" string="Jornada segun" widget="badge" optional="show"
                       decoration-warning="shift_source == 'ninguno'"/>
                <field name="shift_hours" string="Jornada" widget="float_time" optional="hide"/>
                <field name="in_shift_hours" widget="float_time" sum="Dentro"/>
                <field name="off_shift_hours" widget="float_time" sum="Fuera"
                       decoration-bf="off_shift_hours > 0"/>
                <field name="shift_gap_hours" string="Jornada sin senal" widget="float_time"
                       sum="Sin senal" optional="show"/>
                <field name="call_hours" widget="float_time" optional="show"/>
                <field name="expected_hours" widget="float_time" optional="hide"/>
                <field name="unexplained_minutes" optional="show"
                       decoration-warning="unexplained_minutes > 0"/>
                <field name="check_out_missing" string="No cerro salida" optional="show"
                       decoration-warning="check_out_missing"/>
                <field name="check_out_notified" optional="hide"/>
                <field name="adherence" string="Asistencia" widget="badge" optional="show"
                       decoration-success="adherence == 'a_tiempo'"
                       decoration-warning="adherence in ('tarde', 'sin_entrada', 'sin_checada')"
                       decoration-danger="adherence in ('falto', 'sin_senal')"
                       decoration-muted="adherence in ('no_laborable', 'sin_jornada', 'sin_dato')"/>
                <field name="check_in_at" string="Entrada checada" widget="datetime" optional="show"/>
                <field name="check_out_at" string="Salida checada" widget="datetime" optional="show"/>
                <field name="late_minutes" string="Min. tarde" optional="show"
                       decoration-warning="late_minutes > 0"/>
                <field name="left_early" string="Salio antes" optional="show"
                       decoration-warning="left_early"/>
                <field name="early_minutes" string="Min. antes" optional="hide"/>
                <field name="check_in_missing" string="No checo entrada" optional="hide"/>
                <field name="adherence_source" string="Entrada segun" optional="hide"/>
                <field name="leave_name" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'sin_dato'"
                       decoration-warning="state == 'sin_detalle' or state == 'solo_equipo'"/>
            </list>
        </field>
    </record>

    <record id="foco_workday_view_search" model="ir.ui.view">
        <field name="name">foco.workday.search</field>
        <field name="model">foco.workday</field>
        <field name="arch" type="xml">
            <search string="Jornadas">
                <field name="employee_id"/>
                <field name="department_id"/>
                <filter name="f_fuera" string="Trabajo fuera de jornada"
                        domain="[('off_shift_hours', '&gt;', 0)]"/>
                <filter name="f_hueco" string="Jornada sin senal del equipo"
                        domain="[('shift_gap_hours', '&gt;', 0)]"/>
                <filter name="f_sin_explicar" string="Con tiempo sin explicar"
                        domain="[('unexplained_minutes', '&gt;', 0)]"/>
                <filter name="f_sin_salida" string="No cerro salida"
                        domain="[('check_out_missing', '=', True)]"/>
                <separator/>
                <filter name="f_tarde" string="Llego tarde"
                        domain="[('adherence', '=', 'tarde')]"/>
                <filter name="f_falto" string="Sin registro (falto)"
                        domain="[('adherence', 'in', ('falto', 'sin_senal'))]"/>
                <filter name="f_salio_antes" string="Salio antes"
                        domain="[('left_early', '=', True)]"/>
                <filter name="f_no_checo" string="No checo entrada"
                        domain="[('check_in_missing', '=', True)]"/>
                <filter name="f_permiso" string="Permiso o festivo"
                        domain="[('adherence', 'in', ('permiso', 'festivo'))]"/>
                <separator/>
                <filter name="f_hoy" string="Hoy"
                        domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="f_sin_detalle" string="Sin detalle de horas"
                        domain="[('state', '=', 'sin_detalle')]"/>
                <filter name="f_solo_equipo" string="Solo actividad del equipo"
                        domain="[('state', '=', 'solo_equipo')]"/>
                <separator/>
                    <filter name="g_emp" string="Empleado" context="{'group_by': 'employee_id'}"/>
                    <filter name="g_dep" string="Departamento" context="{'group_by': 'department_id'}"/>
                    <filter name="g_dia" string="Dia" context="{'group_by': 'date'}"/>
                    <filter name="g_adh" string="Asistencia" context="{'group_by': 'adherence'}"/>
            </search>
        </field>
    </record>

    <!-- El KPI "Asistencia" del tablero abre la lista filtrada al dia y agrupada
         por estado: tarde, falto, salio antes... con la evidencia en columnas. -->
    <record id="foco_workday_asistencia_action" model="ir.actions.act_window">
        <field name="name">Asistencia</field>
        <field name="res_model">foco.workday</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="foco_workday_view_list"/>
        <field name="search_view_id" ref="foco_workday_view_search"/>
        <field name="domain">[('adherence', 'not in', ('no_laborable', 'sin_jornada', False))]</field>
        <field name="context">{'search_default_f_hoy': 1, 'search_default_g_adh': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin jornadas con asistencia medida</p>
            <p>Cada renglon dice como llego la persona ese dia (a tiempo, tarde,
               sin registro, permiso) con su entrada y salida checadas, los
               minutos y la fuente. Se recalcula con cada envio del agente y
               cada noche.</p>
        </field>
    </record>

    <record id="foco_workday_action" model="ir.actions.act_window">
        <field name="name">Jornadas (detalle)</field>
        <field name="res_model">foco.workday</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="foco_workday_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Todavia no hay jornadas calculadas</p>
            <p>Se arman solas cuando los equipos reportan. Un equipo que nunca
               ha reportado no aparece aqui.</p>
        </field>
    </record>

    <!-- El KPI del tablero "Sin cerrar salida" abre esta vista, ya filtrada a
         los dias en que alguien checo entrada y nunca cerro. -->
    <record id="foco_workday_sin_salida_action" model="ir.actions.act_window">
        <field name="name">Salidas sin cerrar</field>
        <field name="res_model">foco.workday</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="foco_workday_view_list"/>
        <field name="search_view_id" ref="foco_workday_view_search"/>
        <field name="domain">[('check_out_missing', '=', True)]</field>
        <field name="context">{'search_default_g_emp': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nadie dejo una salida sin cerrar</p>
            <p>Aqui aparece quien checo ENTRADA y termino el dia sin checar
               SALIDA. Si la persona la cierra despues o RRHH la corrige, el
               renglon desaparece solo.</p>
        </field>
    </record>
</odoo>
