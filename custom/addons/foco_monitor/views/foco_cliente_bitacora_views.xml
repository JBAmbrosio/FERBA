<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Bitacora de clientes: quien dio de alta, edito o elimino cada cliente,
         contacto y ubicacion desde el telefono. Solo lectura para todos. -->
    <record id="foco_cliente_bitacora_list" model="ir.ui.view">
        <field name="name">foco.cliente.bitacora.list</field>
        <field name="model">foco.cliente.bitacora</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="fecha"/>
                <field name="user_id"/>
                <field name="accion" widget="badge"
                       decoration-success="accion in ('alta', 'contacto_alta', 'ubicacion_alta')"
                       decoration-info="accion in ('edicion', 'contacto_edicion', 'ubicacion_edicion', 'telefono', 'pin')"
                       decoration-danger="accion in ('baja', 'contacto_baja', 'ubicacion_baja')"/>
                <field name="cliente"/>
                <field name="detalle"/>
                <field name="device_id" optional="hide"/>
                <field name="employee_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="foco_cliente_bitacora_form" model="ir.ui.view">
        <field name="name">foco.cliente.bitacora.form</field>
        <field name="model">foco.cliente.bitacora</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="fecha"/>
                            <field name="user_id"/>
                            <field name="employee_id"/>
                            <field name="device_id"/>
                        </group>
                        <group>
                            <field name="accion"/>
                            <field name="cliente"/>
                            <field name="partner_id"/>
                        </group>
                    </group>
                    <group string="Qué cambió">
                        <field name="detalle" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="foco_cliente_bitacora_search" model="ir.ui.view">
        <field name="name">foco.cliente.bitacora.search</field>
        <field name="model">foco.cliente.bitacora</field>
        <field name="arch" type="xml">
            <search>
                <field name="cliente"/>
                <field name="user_id"/>
                <field name="detalle"/>
                <filter name="f_altas" string="Altas"
                        domain="[('accion', 'in', ('alta', 'contacto_alta', 'ubicacion_alta'))]"/>
                <filter name="f_cambios" string="Cambios"
                        domain="[('accion', 'in', ('edicion', 'contacto_edicion', 'ubicacion_edicion', 'telefono', 'pin'))]"/>
                <filter name="f_bajas" string="Bajas"
                        domain="[('accion', 'in', ('baja', 'contacto_baja', 'ubicacion_baja'))]"/>
                <separator/>
                <filter name="g_quien" string="Quién" context="{'group_by': 'user_id'}"/>
                <filter name="g_accion" string="Qué hizo" context="{'group_by': 'accion'}"/>
                <filter name="g_dia" string="Día" context="{'group_by': 'fecha:day'}"/>
            </search>
        </field>
    </record>

    <record id="foco_cliente_bitacora_action" model="ir.actions.act_window">
        <field name="name">Bitácora de clientes</field>
        <field name="res_model">foco.cliente.bitacora</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Todavía no hay movimientos</p>
            <p>Aquí queda cada alta, cambio y baja de clientes, contactos y
               ubicaciones que los vendedores hacen desde el teléfono.</p>
        </field>
    </record>

    <menuitem id="menu_foco_cliente_bitacora" name="Bitácora de clientes"
              parent="menu_foco_sec_ventas" action="foco_cliente_bitacora_action"
              sequence="12"
              groups="foco_monitor.group_foco_manager"/>
</odoo>
