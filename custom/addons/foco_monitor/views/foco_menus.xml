<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- groups: sin pertenecer al grupo de consulta, la aplicacion no aparece
         siquiera en el menu. Administrar implica ver (ver foco_security.xml).

         ESTRUCTURA. Trece entradas de primer nivel saturaban la barra. Se
         agrupan en cuatro secciones por lo que hace cada pantalla, mas el
         Tablero suelto como portada:

           Tablero        la portada, siempre a un clic
           Actividad      lo que hizo la persona (jornada, uso, ausencias, eventos)
           Equipos        lo que se hace SOBRE un equipo (control remoto, bloqueo, altaas)
           Catalogo       lo que se clasifica (aplicaciones, sitios, categorias)
           Configuracion  ajustes y accesos

         Un menu padre sin accion solo se muestra si tiene un hijo visible para
         quien mira, asi que un usuario de solo consulta ve Equipos con
         Computadoras dentro pero sin las acciones de administrador, y no ve
         Configuracion en absoluto. -->
    <menuitem id="menu_foco_root" name="Foco" sequence="90"
              groups="foco_monitor.group_foco_user"/>

    <!-- Portada -->
    <menuitem id="menu_foco_dashboard" name="Tablero"
              parent="menu_foco_root" action="foco_dashboard_action" sequence="10"/>

    <!-- ============================================ ACTIVIDAD (de la persona) -->
    <menuitem id="menu_foco_sec_actividad" name="Actividad"
              parent="menu_foco_root" sequence="20"/>

    <menuitem id="menu_foco_jornada" name="Jornada"
              parent="menu_foco_sec_actividad" action="foco_jornada_client" sequence="10"/>

    <menuitem id="menu_foco_detalle" name="Detalle de uso"
              parent="menu_foco_sec_actividad" action="foco_uso_client" sequence="20"/>

    <menuitem id="menu_foco_ausencias" name="Periodos sin actividad"
              parent="menu_foco_sec_actividad" action="foco_absence_action" sequence="30"/>

    <!-- Justificaciones que la IA leyo y marco como vagas o sin relacion con el
         trabajo. Solo administradores: es una herramienta de supervision. -->
    <menuitem id="menu_foco_periodos_revisar" name="Periodos a revisar"
              parent="menu_foco_sec_actividad" action="foco_absence_review_action" sequence="32"
              groups="foco_monitor.group_foco_manager"/>

    <menuitem id="menu_foco_eventos" name="Eventos del equipo"
              parent="menu_foco_sec_actividad" action="foco_event_action" sequence="40"/>
    <!-- Hechos de integridad: lo medido que puede leerse como intento de
         saltarse la medicion, con evidencia y significado; nunca veredicto. -->
    <menuitem id="menu_foco_integridad" name="Integridad"
              parent="menu_foco_sec_actividad" action="foco_integrity_fact_action" sequence="45"/>
    <!-- Lo que la IA vio en las capturas de un episodio sospechoso y lo que
         decidio una persona despues. Solo administradores: son capturas de la
         pantalla de alguien. -->
    <menuitem id="menu_foco_veredictos" name="Veredictos de la IA"
              parent="menu_foco_sec_actividad" action="foco_integrity_verdict_action" sequence="46"
              groups="foco_monitor.group_foco_manager"/>

    <!-- Llamadas de WhatsApp desde la laptop, ya clasificadas por el modelo.
         Solo administradores: aunque no haya contenido, "llamada personal de
         20 min" es un dato sensible de la persona. -->
    <menuitem id="menu_foco_call_review" name="Llamadas de WhatsApp"
              parent="menu_foco_sec_actividad" action="foco_call_review_action" sequence="50"
              groups="foco_monitor.group_foco_manager"/>

    <!-- =================================================== EQUIPOS (acciones) -->
    <menuitem id="menu_foco_sec_equipos" name="Equipos"
              parent="menu_foco_root" sequence="30"/>

    <menuitem id="menu_foco_computers" name="Computadoras"
              parent="menu_foco_sec_equipos" action="foco_computer_action" sequence="10"/>

    <menuitem id="menu_foco_commands" name="Control remoto"
              parent="menu_foco_sec_equipos" action="foco_command_action" sequence="20"
              groups="foco_monitor.group_foco_manager"/>

    <!-- A la vista, agrupada con las demas acciones sobre equipos: una funcion
         que fotografia la pantalla de las personas esta a un clic, no enterrada
         en Configuracion. Que se vea cuantas hay es parte de que exista. -->
    <menuitem id="menu_foco_capturas" name="Capturas de pantalla"
              parent="menu_foco_sec_equipos" action="foco_capture_action" sequence="30"
              groups="foco_monitor.group_foco_manager"/>

    <menuitem id="menu_foco_policies" name="Navegacion permitida"
              parent="menu_foco_sec_equipos" action="foco_policy_action" sequence="40"
              groups="foco_monitor.group_foco_manager"/>

    <menuitem id="menu_foco_invitaciones" name="Invitaciones"
              parent="menu_foco_sec_equipos" action="foco_invitation_action" sequence="50"
              groups="foco_monitor.group_foco_manager"/>

    <!-- ===================================================== MOVIL (Android) -->
    <!-- Telefonos de la empresa: ubicacion, uso de apps y llamadas. Todo el
         menu es de administrador: es la parte mas sensible del sistema. -->
    <menuitem id="menu_foco_sec_movil" name="Movil"
              parent="menu_foco_root" sequence="35"
              groups="foco_monitor.group_foco_manager"/>

    <menuitem id="menu_foco_movil_tablero" name="Tablero movil"
              parent="menu_foco_sec_movil" action="foco_movil_client" sequence="5"
              groups="foco_monitor.group_foco_manager"/>

    <menuitem id="menu_foco_devices" name="Dispositivos"
              parent="menu_foco_sec_movil" action="foco_mobile_device_action" sequence="10"
              groups="foco_monitor.group_foco_manager"/>

    <menuitem id="menu_foco_locations" name="Ubicaciones"
              parent="menu_foco_sec_movil" action="foco_location_action" sequence="20"
              groups="foco_monitor.group_foco_manager"/>

    <menuitem id="menu_foco_mobile_usage" name="Uso de apps"
              parent="menu_foco_sec_movil" action="foco_mobile_usage_action" sequence="30"
              groups="foco_monitor.group_foco_manager"/>

    <menuitem id="menu_foco_mobile_apps" name="Apps (catalogo)"
              parent="menu_foco_sec_movil" action="foco_mobile_app_action" sequence="35"
              groups="foco_monitor.group_foco_manager"/>

    <menuitem id="menu_foco_calls" name="Llamadas"
              parent="menu_foco_sec_movil" action="foco_call_action" sequence="40"
              groups="foco_monitor.group_foco_manager"/>

    <menuitem id="menu_foco_mobile_captures" name="Capturas"
              parent="menu_foco_sec_movil" action="foco_mobile_capture_action" sequence="50"
              groups="foco_monitor.group_foco_manager"/>

    <!-- ================================================= VENTAS EN CAMPO -->
    <!-- El flujo de vendedores: el mapa de clientes (reemplaza el Google My Maps
         a mano), la cartera de clientes, las visitas y el importador de la Hoja
         Maestra. De administrador: es la cartera comercial y la ubicacion de los
         clientes y vendedores. -->
    <menuitem id="menu_foco_sec_ventas" name="Ventas en campo"
              parent="menu_foco_root" sequence="36"
              groups="foco_monitor.group_foco_manager"/>

    <menuitem id="menu_foco_vendedores_mapa" name="Mapa de clientes"
              parent="menu_foco_sec_ventas" action="foco_vendedores_client" sequence="5"
              groups="foco_monitor.group_foco_manager"/>

    <menuitem id="menu_foco_vendedores_clientes" name="Clientes"
              parent="menu_foco_sec_ventas" action="foco_cliente_ventas_action" sequence="10"
              groups="foco_monitor.group_foco_manager"/>

    <menuitem id="menu_foco_vendedores_visitas" name="Visitas"
              parent="menu_foco_sec_ventas" action="foco_visita_action" sequence="20"
              groups="foco_monitor.group_foco_manager"/>

    <menuitem id="menu_foco_vendedores_import" name="Importar Hoja Maestra"
              parent="menu_foco_sec_ventas" action="foco_vendedor_import_action" sequence="30"
              groups="foco_monitor.group_foco_manager"/>

    <!-- ================================================= CATALOGO (clasificar) -->
    <menuitem id="menu_foco_sec_catalogo" name="Catalogo"
              parent="menu_foco_root" sequence="40"/>

    <menuitem id="menu_foco_apps" name="Aplicaciones"
              parent="menu_foco_sec_catalogo" action="foco_app_action" sequence="10"/>

    <menuitem id="menu_foco_sites" name="Sitios"
              parent="menu_foco_sec_catalogo" action="foco_site_action" sequence="20"/>

    <menuitem id="menu_foco_sites_cola" name="Sitios por clasificar"
              parent="menu_foco_sec_catalogo" action="foco_usage_action_sitios" sequence="30"
              groups="foco_monitor.group_foco_manager"/>

    <menuitem id="menu_foco_categories" name="Categorias"
              parent="menu_foco_sec_catalogo" action="foco_category_action" sequence="40"/>

    <!-- ===================================================== CONFIGURACION -->
    <menuitem id="menu_foco_config" name="Configuracion"
              parent="menu_foco_root" sequence="90"
              groups="foco_monitor.group_foco_manager"/>

    <!-- Antes "Horario": un horario global editable que, desde que RRHH
         asigna calendarios, no gobernaba a nadie. Ahora dice de donde sale la
         jornada de cada persona (checador o calendario) y no se edita aqui. -->
    <!-- Editor del horario laboral POR EMPLEADO (dias, entrada/salida, comida).
         Escribe el calendario nativo; de aqui salen todas las metricas. -->
    <menuitem id="menu_foco_horarios" name="Horarios laborales"
              parent="menu_foco_config" action="foco_horarios_action" sequence="4"
              groups="foco_monitor.group_foco_manager"/>

    <menuitem id="menu_foco_horario" name="Jornada"
              parent="menu_foco_config" action="foco_settings_client" sequence="5"/>

    <!-- La ventana bloqueante de justificacion de inactividad: umbral GLOBAL en
         minutos y a QUIEN le sale (por empleado, apagada para todos de fabrica). -->
    <menuitem id="menu_foco_ventana" name="Ventana de inactividad"
              parent="menu_foco_config" action="foco_ventana_action" sequence="6"
              groups="foco_monitor.group_foco_manager"/>

    <!-- Monitoreo periodico de pantalla POR EMPLEADO: que apps, cada cuanto, y
         cuanto viven las capturas. Vive en Configuracion porque es una politica
         que se define, no una accion sobre un equipo. -->
    <menuitem id="menu_foco_watch" name="Monitoreo de pantalla"
              parent="menu_foco_config" action="foco_watch_action" sequence="7"
              groups="foco_monitor.group_foco_manager"/>

    <menuitem id="menu_foco_movil_ajustes" name="Movil (ubicacion y llamadas)"
              parent="menu_foco_config" action="foco_settings_movil_action" sequence="8"
              groups="foco_monitor.group_foco_manager"/>

    <menuitem id="menu_foco_accesos" name="Accesos"
              parent="menu_foco_config" action="foco_access_action" sequence="10"
              groups="foco_monitor.group_foco_manager"/>

    <!-- Lo que se le pregunto a Tomy y lo que contesto: Tomy habla de
         personas, asi que cada conversacion queda a la vista del administrador. -->
    <menuitem id="menu_foco_tomy" name="Conversaciones con Tomy"
              parent="menu_foco_config" action="foco_tomy_thread_action" sequence="12"
              groups="foco_monitor.group_foco_manager"/>

    <!-- La tabla generica sigue accesible, pero deja de ser la puerta: abrir
         una pestana en tabla dinamica es pedirle al usuario que construya la
         pregunta antes de poder verla. Vive en Configuracion, como herramienta
         avanzada, no como la entrada normal. -->
    <menuitem id="menu_foco_detalle_tabla" name="Tabla de uso"
              parent="menu_foco_config" action="foco_usage_action" sequence="20"
              groups="foco_monitor.group_foco_manager"/>

    <menuitem id="menu_foco_jornadas_detalle" name="Jornadas (detalle)"
              parent="menu_foco_config" action="foco_workday_action" sequence="30"/>

    <!-- El icono del lanzador de aplicaciones sale de web_icon, NO de
         static/description/icon.png (esa imagen solo se usa en la lista de
         Aplicaciones). Y web_icon no se puede poner como atributo de
         <menuitem>: el esquema de Odoo 19 solo admite id, name, sequence,
         groups y active. Se asigna como campo del registro. -->
    <record id="menu_foco_root" model="ir.ui.menu">
        <field name="web_icon">foco_monitor,static/description/icon.png</field>
    </record>
</odoo>
