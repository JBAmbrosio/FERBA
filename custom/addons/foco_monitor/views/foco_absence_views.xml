<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="foco_absence_view_list" model="ir.ui.view">
        <field name="name">foco.absence.list</field>
        <field name="model">foco.absence</field>
        <field name="arch" type="xml">
            <!-- Regla de los 90 min: verde = justificada (cabe en su bolsa o la
                 acepto el admin); azul = por decidir (paso de la bolsa); rojo =
                 rechazada; ambar = sin justificar. -->
            <list decoration-success="state == 'justificada'"
                  decoration-warning="state == 'pendiente'"
                  decoration-info="state == 'por_decidir'"
                  decoration-danger="state == 'rechazada'"
                  decoration-muted="state == 'auto'">
                <field name="start"/>
                <field name="stop"/>
                <field name="employee_id"/>
                <field name="duration" widget="float_time" sum="Total"/>
                <field name="kind"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'justificada'"
                       decoration-warning="state == 'pendiente'"
                       decoration-info="state == 'por_decidir'"
                       decoration-danger="state == 'rechazada'"/>
                <field name="cubierta_por" optional="show"/>
                <field name="gracia_min" string="De sus 90" optional="show"
                       invisible="cubierta_por != 'gracia'"/>
                <field name="gracia_restante_min" string="Le quedan" optional="show"
                       invisible="cubierta_por != 'gracia'"/>
                <field name="reason"/>
                <field name="note" optional="show"/>
                <button name="action_aceptar" type="object" string="Aceptar" icon="fa-check"
                        class="btn-success btn-sm" invisible="state != 'por_decidir'"/>
                <button name="action_rechazar" type="object" string="Rechazar" icon="fa-times"
                        class="btn-outline-danger btn-sm" invisible="state != 'por_decidir'"/>
                <field name="ai_veredicto" optional="hide"/>
                <field name="ai_pregunta" optional="hide"/>
                <field name="ai_categoria" optional="show"/>
                <field name="ai_motivo" optional="hide"/>
                <field name="ai_requiere_revision" optional="hide"/>
                <field name="ai_incoherente" optional="hide"/>
                <field name="origen_id" optional="hide"/>
                <field name="decidido_por" optional="hide"/>
                <field name="answered_via" optional="hide"/>
                <field name="computer_id" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Lista dedicada de "Periodos a revisar": lo que la IA vio y quien ya lo
         reviso van al frente; aqui lo que importa es la nota y el veredicto. -->
    <record id="foco_absence_review_list" model="ir.ui.view">
        <field name="name">foco.absence.review.list</field>
        <field name="model">foco.absence</field>
        <field name="arch" type="xml">
            <list decoration-muted="review_visto" default_order="start desc">
                <field name="start"/>
                <field name="employee_id"/>
                <field name="duration" widget="float_time" sum="Total"/>
                <field name="reason"/>
                <field name="note"/>
                <field name="state" widget="badge" optional="show"
                       decoration-success="state == 'justificada'"
                       decoration-warning="state == 'pendiente'"
                       decoration-info="state == 'por_decidir'"
                       decoration-danger="state == 'rechazada'"/>
                <field name="ai_veredicto" widget="badge"
                       decoration-warning="ai_veredicto in ('vaga', 'insuficiente')"/>
                <field name="ai_pregunta" optional="show"/>
                <field name="ai_categoria" optional="show"/>
                <field name="ai_motivo"/>
                <button name="action_aceptar" type="object" string="Aceptar" icon="fa-check"
                        class="btn-success btn-sm" invisible="state != 'por_decidir'"/>
                <button name="action_rechazar" type="object" string="Rechazar" icon="fa-times"
                        class="btn-outline-danger btn-sm" invisible="state != 'por_decidir'"/>
                <field name="ai_confianza" widget="percentage" optional="show"/>
                <field name="rebotes" string="Devuelta (veces)" optional="show"/>
                <field name="rebote_pendiente" string="Devuelta ahora" optional="show"/>
                <field name="nota_rechazada" optional="hide"/>
                <field name="review_visto" string="Revisado"/>
                <field name="review_por" optional="hide"/>
                <field name="ai_requiere_revision" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="foco_absence_view_form" model="ir.ui.view">
        <field name="name">foco.absence.form</field>
        <field name="model">foco.absence</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_aceptar" type="object" string="Aceptar"
                            class="btn-success" icon="fa-check"
                            invisible="state != 'por_decidir'"/>
                    <button name="action_rechazar" type="object" string="Rechazar"
                            class="btn-danger" icon="fa-times"
                            invisible="state != 'por_decidir'"/>
                    <button name="action_reconsiderar" type="object" string="Volver a Por decidir"
                            invisible="not (state == 'rechazada' or (state == 'justificada' and cubierta_por == 'admin'))"/>
                    <button name="action_marcar_revisado" type="object" string="Marcar revisado"
                            class="btn-primary" icon="fa-check"
                            invisible="review_visto or not ai_requiere_revision"/>
                    <button name="action_reabrir_revision" type="object" string="Reabrir"
                            invisible="not review_visto"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="employee_id" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="state != 'por_decidir'">
                        Esta justificacion paso de los minutos justificables del dia de la persona.
                        No cuenta como cubierta hasta que la aceptes. Si la rechazas, queda como
                        tiempo sin cubrir.
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="not ai_requiere_revision or review_visto">
                        La IA marco esta justificacion como VAGA o INSUFICIENTE:
                        <field name="ai_motivo" readonly="1" nolabel="1"/>. Revisala con la persona y
                        marca "Revisado". Es evidencia del modelo, no un veredicto final.
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="not ai_incoherente or review_visto">
                        El empleado declaro estar fuera de su horario, pero este hueco cae DENTRO
                        de su jornada configurada. Es un DATO, no una acusacion: puede ser una
                        evasion o que el horario configurado no sea el real.
                    </div>
                    <group>
                        <group string="Periodo">
                            <field name="start" readonly="1"/>
                            <field name="stop" readonly="1"/>
                            <field name="duration" widget="float_time" readonly="1"/>
                            <field name="kind" readonly="1"/>
                            <field name="computer_id" readonly="1"/>
                        </group>
                        <group string="Justificacion">
                            <field name="state"/>
                            <field name="reason"/>
                            <field name="note"/>
                            <field name="answered_at" readonly="1"/>
                            <field name="answered_via" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Revision por IA">
                            <field name="ai_estado" readonly="1"/>
                            <field name="ai_veredicto" readonly="1"/>
                            <field name="ai_categoria" readonly="1"/>
                            <field name="ai_requiere_revision" readonly="1"/>
                            <field name="ai_incoherente" readonly="1"/>
                            <field name="ai_motivo" readonly="1"/>
                            <field name="ai_confianza" widget="percentage" readonly="1"/>
                            <field name="ai_at" readonly="1"/>
                            <field name="ai_modelo" readonly="1" optional="hide"/>
                        </group>
                        <group string="Revision humana">
                            <field name="review_visto"/>
                            <field name="review_por" readonly="1"/>
                            <field name="review_at" readonly="1"/>
                            <field name="review_nota"/>
                        </group>
                        <group string="Devuelta al empleado">
                            <field name="rebote_pendiente" readonly="1"/>
                            <field name="rebotes" readonly="1"/>
                            <field name="nota_rechazada" readonly="1"/>
                            <field name="ai_pregunta" readonly="1"/>
                        </group>
                        <group string="Regla de los 90 minutos">
                            <field name="cubierta_por" readonly="1"/>
                            <field name="gracia_min" readonly="1" invisible="cubierta_por != 'gracia'"/>
                            <field name="gracia_restante_min" readonly="1" invisible="cubierta_por != 'gracia'"/>
                            <field name="origen_id" readonly="1" invisible="not origen_id"/>
                            <field name="decidido_por" readonly="1" invisible="not decidido_por"/>
                            <field name="decidido_at" readonly="1" invisible="not decidido_at"/>
                            <field name="decision_nota"/>
                        </group>
                    </group>
                    <group string="Diagnostico">
                        <field name="expected_seconds" readonly="1"
                               help="Cuanto de este periodo caia dentro de la jornada del empleado. Si es casi cero, el calendario ya lo explica y no se le pregunta."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="foco_absence_view_search" model="ir.ui.view">
        <field name="name">foco.absence.search</field>
        <field name="model">foco.absence</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="reason"/>
                <filter name="pendientes" string="Por justificar"
                        domain="[('state', '=', 'pendiente')]"/>
                <filter name="justificadas" string="Justificadas"
                        domain="[('state', '=', 'justificada')]"/>
                <filter name="por_decidir" string="Por decidir (pasaron de sus 90 min)"
                        domain="[('state', '=', 'por_decidir')]"/>
                <filter name="rechazadas" string="Rechazadas por el admin"
                        domain="[('state', '=', 'rechazada')]"/>
                <filter name="auto" string="Explicadas por calendario"
                        domain="[('state', '=', 'auto')]"/>
                <separator/>
                <filter name="de_sus_90" string="De sus 90 min"
                        domain="[('cubierta_por', '=', 'gracia')]"/>
                <filter name="aceptadas_admin" string="Aceptadas por el admin"
                        domain="[('cubierta_por', '=', 'admin')]"/>
                <separator/>
                <filter name="a_revisar" string="La IA marcó a revisar"
                        domain="[('ai_requiere_revision', '=', True)]"/>
                <filter name="sin_revisar" string="Sin revisar"
                        domain="[('ai_requiere_revision', '=', True), ('review_visto', '=', False)]"/>
                <filter name="revisadas" string="Ya revisadas"
                        domain="[('review_visto', '=', True)]"/>
                <filter name="incoherentes" string="No coincide con su horario"
                        domain="[('ai_incoherente', '=', True)]"/>
                <filter name="devueltas" string="Devueltas al empleado ahora"
                        domain="[('rebote_pendiente', '=', True)]"/>
                <separator/>
                <filter name="semana" string="Ultimos 7 dias"
                        domain="[('start', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="g_emp" string="Empleado" context="{'group_by': 'employee_id'}"/>
                <filter name="g_state" string="Estado" context="{'group_by': 'state'}"/>
                <filter name="g_reason" string="Motivo" context="{'group_by': 'reason'}"/>
                <filter name="g_kind" string="Tipo" context="{'group_by': 'kind'}"/>
                <filter name="g_veredicto" string="Veredicto IA" context="{'group_by': 'ai_veredicto'}"/>
                <filter name="g_categoria" string="Categoria IA" context="{'group_by': 'ai_categoria'}"/>
            </search>
        </field>
    </record>

    <!-- Periodos a revisar: lo que la IA marco como justificacion vaga o sin
         relacion con el trabajo y nadie ha revisado todavia. -->
    <record id="foco_absence_review_action" model="ir.actions.act_window">
        <field name="name">Periodos a revisar</field>
        <field name="res_model">foco.absence</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="foco_absence_review_list"/>
        <field name="search_view_id" ref="foco_absence_view_search"/>
        <field name="domain">[('ai_requiere_revision', '=', True)]</field>
        <field name="context">{'search_default_sin_revisar': 1, 'search_default_g_emp': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nada por revisar</p>
            <p>Aqui llegan solo las justificaciones que la IA leyó y marcó como
               VAGAS: las que no dan ninguna razón (por ejemplo «Otro» con una
               nota de «.»). Una razón escrita, aunque sea discutible, no cae
               aquí. La IA las analiza sola; tú las revisas con la persona y
               marcas «Revisado». Es evidencia del modelo, nunca un veredicto
               final.</p>
        </field>
    </record>

    <record id="foco_absence_action" model="ir.actions.act_window">
        <field name="name">Periodos sin actividad</field>
        <field name="res_model">foco.absence</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="foco_absence_view_search"/>
        <field name="context">{'search_default_pendientes': 1, 'search_default_g_emp': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin periodos registrados</p>
            <p>Aqui aparecen los huecos de la jornada que el sistema no puede
               explicar solo. Los que caen fuera del horario o en la comida del
               calendario entran como "Explicadas por calendario" y nadie tiene
               que contestarlas. Regla de los 90 minutos: lo que la persona
               justifica se carga a su bolsa del dia; lo que pasa de ahi queda
               "Por decidir" con Aceptar y Rechazar.</p>
        </field>
    </record>
</odoo>
