<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================ LA PANTALLA (chat) -->
    <!-- El asistente de uso general. Lo ve quien tenga acceso (group_foco_gpt) y
         los administradores. La pantalla es un componente OWL (static/src/gpt). -->
    <record id="foco_gpt_action" model="ir.actions.client">
        <field name="name">Tommy GPT</field>
        <field name="tag">foco_gpt</field>
    </record>

    <!-- ===================================== ACCESO (quien puede usarlo) -->
    <!-- Una linea por persona con su casilla. El administrador de Foco la
         enciende sin tocar nada mas; por dentro mueve el grupo group_foco_gpt. -->
    <record id="foco_gpt_access_view_list" model="ir.ui.view">
        <field name="name">res.users.list.foco.gpt</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <list string="Acceso a Tommy GPT" editable="bottom" create="0" delete="0">
                <field name="name" readonly="1"/>
                <field name="login" readonly="1"/>
                <field name="foco_gpt_enabled"/>
            </list>
        </field>
    </record>

    <record id="foco_gpt_access_action" model="ir.actions.act_window">
        <field name="name">Acceso a Tommy GPT</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="foco_gpt_access_view_list"/>
        <field name="domain">[('share', '=', False), ('active', '=', True)]</field>
        <field name="context">{'create': False, 'delete': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Enciende el asistente para quien lo necesite</p>
            <p>Marca la casilla de cada persona que podra usar Tommy GPT con la
               llave de la empresa. No le das acceso a ningun otro dato de Foco.</p>
        </field>
    </record>

    <!-- ===================================== AUDITORIA (conversaciones) -->
    <record id="foco_gpt_thread_view_list" model="ir.ui.view">
        <field name="name">foco.gpt.thread.list</field>
        <field name="model">foco.gpt.thread</field>
        <field name="arch" type="xml">
            <list string="Conversaciones con Tommy GPT" create="0">
                <field name="last_at" string="Ultimo mensaje"/>
                <field name="user_id"/>
                <field name="name" string="Titulo"/>
                <field name="message_count" string="Mensajes"/>
                <field name="clasificacion" widget="badge"
                       decoration-success="clasificacion == 'trabajo'"
                       decoration-danger="clasificacion == 'distraccion'"
                       decoration-warning="clasificacion == 'mixta'"
                       decoration-muted="clasificacion in ('indeterminada', 'pendiente')"/>
                <field name="clasificacion_motivo" string="Motivo" optional="show"/>
                <field name="tokens" optional="hide"/>
                <field name="costo_usd" string="Costo USD" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="foco_gpt_thread_view_form" model="ir.ui.view">
        <field name="name">foco.gpt.thread.form</field>
        <field name="model">foco.gpt.thread</field>
        <field name="arch" type="xml">
            <form string="Conversacion con Tommy GPT" create="0" edit="0">
                <header>
                    <button name="accion_clasificar" type="object" string="Clasificar"
                            class="btn-secondary"
                            groups="foco_monitor.group_foco_manager"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="last_at"/>
                            <field name="message_count"/>
                        </group>
                        <group>
                            <field name="clasificacion"/>
                            <field name="clasificacion_motivo"/>
                            <field name="clasificacion_confianza"/>
                            <field name="tokens"/>
                            <field name="costo_usd"/>
                        </group>
                    </group>
                    <field name="message_ids" readonly="1">
                        <list>
                            <field name="role"/>
                            <field name="content"/>
                            <field name="tokens" optional="hide"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="foco_gpt_thread_view_search" model="ir.ui.view">
        <field name="name">foco.gpt.thread.search</field>
        <field name="model">foco.gpt.thread</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="name"/>
                <filter name="trabajo" string="Trabajo" domain="[('clasificacion', '=', 'trabajo')]"/>
                <filter name="distraccion" string="Distraccion" domain="[('clasificacion', '=', 'distraccion')]"/>
                <filter name="mixta" string="Mixta" domain="[('clasificacion', '=', 'mixta')]"/>
                <filter name="sin_clasificar" string="Sin clasificar"
                        domain="[('clasificacion', 'in', ('pendiente', 'indeterminada'))]"/>
                <separator/>
                <filter name="g_user" string="Persona" context="{'group_by': 'user_id'}"/>
                <filter name="g_clas" string="Uso" context="{'group_by': 'clasificacion'}"/>
            </search>
        </field>
    </record>

    <record id="foco_gpt_thread_action" model="ir.actions.act_window">
        <field name="name">Conversaciones (Tommy GPT)</field>
        <field name="res_model">foco.gpt.thread</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="foco_gpt_thread_view_search"/>
        <field name="context">{'search_default_sin_clasificar': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aun no hay conversaciones</p>
            <p>Aqui quedan las platicas de cada persona con Tommy GPT, con la
               clasificacion automatica de si fueron de trabajo o una distraccion.</p>
        </field>
    </record>
</odoo>
