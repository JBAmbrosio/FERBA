<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================== CATALOGO DE APPS MOVILES -->
    <record id="foco_mobile_app_view_list" model="ir.ui.view">
        <field name="name">foco.mobile.app.list</field>
        <field name="model">foco.mobile.app</field>
        <field name="arch" type="xml">
            <list string="Apps moviles" editable="bottom"
                  decoration-muted="no_captura"
                  decoration-success="registrada">
                <field name="app_label"/>
                <field name="package"/>
                <field name="registrada" widget="boolean_toggle"/>
                <field name="no_captura" widget="boolean_toggle"/>
                <field name="last_seen"/>
            </list>
        </field>
    </record>

    <record id="foco_mobile_app_view_form" model="ir.ui.view">
        <field name="name">foco.mobile.app.form</field>
        <field name="model">foco.mobile.app</field>
        <field name="arch" type="xml">
            <form string="App movil">
                <sheet>
                    <group>
                        <group string="Clasificación">
                            <field name="app_label"/>
                            <field name="package"/>
                            <field name="registrada"/>
                            <field name="no_captura"/>
                        </group>
                        <group string="Rastro">
                            <field name="first_seen"/>
                            <field name="last_seen"/>
                            <field name="sistema"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        Una app REGISTRADA (herramienta de trabajo) no recibe
                        captura periodica. Una NO registrada si, cada N min
                        mientras este al frente. "Nunca capturar" es una garantia
                        de privacidad aparte (banca, contrasenas), este o no
                        registrada.
                    </div>
                    <group string="APK propio · empuje silencioso desde Odoo" class="mt16">
                        <div colspan="2" class="alert alert-light border" role="alert">
                            Sube aquí el <b>.apk</b> de una app <b>propia o de código abierto</b>
                            (nunca una de la Play Store). Foco, como dueña del equipo, la
                            instala y la actualiza sola, sin que la persona toque nada. Para
                            que llegue a los teléfonos, agrégala en el perfil como
                            <b>«instalar sola»</b>: <b>Navegación permitida</b> › el perfil ›
                            <b>En el celular</b> › <b>Apps del perfil</b>. Sin APK, «instalar
                            sola» no puede hacer nada.
                        </div>
                        <group>
                            <field name="apk" filename="apk_name"/>
                            <field name="apk_name" invisible="1"/>
                            <field name="apk_version_code"/>
                        </group>
                        <group>
                            <field name="apk_sha256" readonly="1" invisible="not apk"/>
                            <field name="installed_count" string="Teléfonos que la tienen"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="foco_mobile_app_view_search" model="ir.ui.view">
        <field name="name">foco.mobile.app.search</field>
        <field name="model">foco.mobile.app</field>
        <field name="arch" type="xml">
            <search string="Apps moviles">
                <field name="app_label"/>
                <field name="package"/>
                <filter name="f_no_registradas" string="No registradas"
                        domain="[('registrada', '=', False)]"/>
                <filter name="f_registradas" string="Registradas"
                        domain="[('registrada', '=', True)]"/>
                <filter name="f_no_captura" string="Nunca capturar"
                        domain="[('no_captura', '=', True)]"/>
                <separator/>
                <filter name="g_registrada" string="Registrada"
                        context="{'group_by': 'registrada'}"/>
            </search>
        </field>
    </record>

    <!-- ============== APPS REQUERIDAS POR PUESTO (hr.job) ============== -->
    <record id="hr_job_form_foco_apps" model="ir.ui.view">
        <field name="name">hr.job.form.foco.apps</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Foco · apps requeridas del puesto"
                       groups="foco_monitor.group_foco_manager">
                    <div colspan="2" class="text-muted">
                        Apps que Foco instala a TODOS los de este puesto y que el
                        usuario NO puede quitar. Lo que la persona pida y le aprueben
                        (nivel equipo) sí lo puede quitar.
                    </div>
                    <field name="foco_app_ids" nolabel="1" colspan="2"
                           context="{'default_install_type': 'force'}">
                        <list editable="bottom">
                            <field name="app_id"/>
                            <field name="install_type"/>
                            <field name="note"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>

    <record id="foco_mobile_app_action" model="ir.actions.act_window">
        <field name="name">Apps moviles</field>
        <field name="res_model">foco.mobile.app</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_f_no_registradas': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aun no hay apps en el catalogo</p>
            <p>Se llenan solas conforme los telefonos reportan su uso. Marca las de
               trabajo como "registradas" para que no se les tome captura periodica.</p>
        </field>
    </record>

</odoo>
