<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="foco_policy_view_list" model="ir.ui.view">
        <field name="name">foco.policy.list</field>
        <field name="model">foco.policy</field>
        <field name="arch" type="xml">
            <list string="Perfiles de navegacion">
                <field name="name"/>
                <field name="computer_count" string="Equipos"/>
                <field name="rule_count" string="Reglas"/>
                <!-- Lo que de verdad esta pasando, en la lista y no solo dentro:
                     un perfil bien armado que no se aplica a nadie se ve igual
                     que uno que si, y esa confusion es la que trae a preguntar. -->
                <field name="estado_nota" string="Estado"/>
                <field name="note" optional="hide"/>
                <field name="version" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="foco_policy_view_form" model="ir.ui.view">
        <field name="name">foco.policy.form</field>
        <field name="model">foco.policy</field>
        <field name="arch" type="xml">
            <form string="Perfil de navegacion">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Ventas, Diseno, Planta..."/></h1>
                    </div>

                    <!-- ESTADO, arriba del todo. La pregunta que trae a esta
                         pantalla no es "que reglas tiene" sino "por que no pasa
                         nada", y esa se contesta aqui o no se contesta. -->
                    <field name="activo_global" invisible="1"/>
                    <div class="alert alert-warning d-flex align-items-center gap-2"
                         role="alert" invisible="activo_global">
                        <field name="estado_nota" nolabel="1" readonly="1" class="flex-grow-1"/>
                        <button name="action_encender_bloqueo" type="object"
                                string="Encender el bloqueo" class="btn-primary btn-sm"
                                confirm="Se va a aplicar el bloqueo de sitios en TODOS los equipos que tengan perfil. Continuar?"/>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="not activo_global">
                        <field name="estado_nota" nolabel="1" readonly="1"/>
                    </div>

                    <!-- 1. A QUIEN. Antes esto no se podia hacer desde aqui:
                         habia que ir a Computadoras a cambiarlo equipo por
                         equipo, y la pestana de este formulario salia vacia. -->
                    <group string="1 · A qué equipos se aplica">
                        <field name="computer_assign_ids" nolabel="1"
                               widget="many2many_tags"
                               options="{'no_create': True}"
                               placeholder="Escribe el nombre del equipo y elígelo…"/>
                        <div class="text-muted" colspan="2">
                            Un equipo solo puede tener un perfil. Asignarlo aquí lo
                            quita del que tuviera antes. Los equipos sin perfil propio
                            toman el <b>perfil por omisión</b> de Ajustes.
                        </div>
                    </group>

                    <!-- 2. QUE. Con la regla que hay que entender ANTES de
                         escribir la primera, no después de que no funcione. -->
                    <group string="2 · Qué se bloquea">
                        <div colspan="2" class="alert alert-light border" role="alert">
                            Un dominio incluye <b>todos sus subdominios</b>: bloquear
                            <code>youtube.com</code> también tumba
                            <code>music.youtube.com</code>. Para abrir una excepción,
                            agrégalo con acción <b>Permitir</b> — permitir gana sobre
                            bloquear.
                            <br/>
                            <b>Horario y cuota.</b> Una regla con Desde y Hasta aplica solo en
                            esa ventana (hora del equipo) y en los días que diga. Con cuota,
                            <b>Permitir</b> vale hasta esos minutos al día y <b>Bloquear</b>
                            entra al superarlos. Ejemplo: bloquear <code>youtube.com</code>
                            todo el día y permitirlo de 14:00 a 15:00, o permitirlo hasta
                            30 min. La cuota se vence con hasta diez minutos de retraso
                            (lo que tarda el equipo en reportar y volver a preguntar).
                        </div>
                        <field name="rule_ids" nolabel="1" colspan="2">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="pattern"
                                       placeholder="youtube.com   ·   music.youtube.com   ·   ejemplo.com/foro"/>
                                <field name="action"/>
                                <field name="days" placeholder="1,2,3,4,5" optional="show"/>
                                <field name="hour_from" widget="float_time" optional="show"/>
                                <field name="hour_to" widget="float_time" optional="show"/>
                                <field name="quota_minutes" optional="show"/>
                                <field name="condicionada" column_invisible="1"/>
                                <!-- Contra que sitios REALES pega el patron.
                                     Va junto al patron, no en un tooltip: el
                                     dedazo se caza mirando, no buscando. -->
                                <field name="alcance" readonly="1" optional="show"/>
                                <field name="note" placeholder="Por qué"/>
                                <field name="active" widget="boolean_toggle" optional="hide"/>
                            </list>
                        </field>
                    </group>

                    <!-- 3. LOS QUE NO OBEDECEN. Medido (17-sep-2026): Opera
                         ignora la politica que Chrome, Edge, Brave y Firefox si
                         cumplen, y trae VPN integrada. No se puede hacer que
                         bloquee; se puede hacer que no corra. -->
                    <group string="3 · Navegadores que se saltan el bloqueo">
                        <field name="close_unmanaged" widget="boolean_toggle"/>
                        <field name="kill_exes" invisible="not close_unmanaged"
                               placeholder="opera.exe&#10;opera_gx.exe"/>
                        <field name="kill_products" invisible="not close_unmanaged"
                               placeholder="Opera"/>
                        <div class="text-muted" colspan="2">
                            Opera <b>no obedece</b> la política de empresa que sí cumplen
                            Chrome, Edge, Brave y Firefox, y además trae una VPN integrada que
                            brinca cualquier bloqueo. El servicio del equipo cierra estos
                            programas en cuanto abren, avisa en pantalla («no está permitido
                            en este equipo, usa Chrome o Edge») y lo registra en
                            <b>Actividad</b> como «Navegador no permitido cerrado».
                            Solo aplica con el bloqueo de sitios encendido.
                            La lista de <b>productos</b> mira lo que el programa declara ser
                            (Propiedades › Detalles del .exe): un <code>opera.exe</code> renombrado
                            sigue diciendo «Opera Internet Browser» y se cierra igual.
                        </div>
                    </group>

                    <!-- 4. COMO MIDE. Hasta el 27-sep esto vivia en el foco.ini de
                         cada laptop; cambiarlo era tocar tres maquinas. -->
                    <group string="4 · Cómo mide el agente en estos equipos">
                        <group>
                            <field name="idle_secs"/>
                            <field name="measure_off_shift" widget="boolean_toggle"/>
                            <field name="integrity_enabled" widget="boolean_toggle"/>
                            <field name="calls_enabled" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="ask_cooldown_secs"/>
                            <field name="ask_max_idle_secs"/>
                            <field name="screen_change_secs"/>
                        </group>
                        <field name="managed_browsers" colspan="2"
                               placeholder="Chrome&#10;Edge&#10;Firefox&#10;Brave"/>
                        <div class="text-muted" colspan="2">
                            El equipo adopta estos valores en su siguiente envío (cinco minutos)
                            y los conserva aunque se quede sin red. No dependen del bloqueo de
                            sitios: cómo se mide no es lo mismo que qué se bloquea.
                            <br/>La <b>ventana de justificación</b> (a quién le sale y a partir de
                            cuántos minutos de inactividad) ya <b>no se decide por perfil</b>:
                            está apagada para todos y se enciende por persona en
                            <b>Configuración › Ventana de inactividad</b>. Los tiempos de arriba
                            (cada cuánto reabre, idle máximo) solo aplican a quien la tenga encendida.
                        </div>
                    </group>

                    <!-- El perfil del PUESTO para la IA que clasifica las
                         pestañas abiertas. Lo que no encaja aparece en
                         Actividad › Pestañas por revisar para aprobar o bloquear. -->
                    <group string="Perfil del puesto (para clasificar pestañas con IA)">
                        <field name="rol_prompt" nolabel="1" colspan="2"
                               placeholder="Describe qué hace este puesto. Ej.: Un diseñador trabaja con CAD, catálogos de proveedores de piezas, correo y el ERP. No es parte de su trabajo ver deportes, redes sociales ni streaming."/>
                        <div class="text-muted" colspan="2">
                            La IA usa esta descripción para decidir si una pestaña abierta encaja
                            con el puesto. Las que no, aparecen en
                            <b>Actividad › Pestañas por revisar</b> para aprobarlas o bloquearlas.
                        </div>
                    </group>

                    <!-- Clasificacion de productividad PROPIA de este perfil: la
                         misma app o sitio puede contar productivo en un perfil y
                         distraccion en otro (reunion 9-oct-2026). Gana sobre la
                         clasificacion global; lo que no se ponga aqui usa la general. -->
                    <group string="Clasificación de productividad de este perfil">
                        <div colspan="2" class="alert alert-light border" role="alert">
                            Decide si una <b>app</b> o un <b>sitio</b> cuenta como
                            productivo o distracción <b>solo para los equipos de este
                            perfil</b>. Ejemplo: <code>WhatsApp</code> puede ser
                            <b>productivo</b> en «compras y ventas» y <b>distracción</b>
                            en «Oficina técnica». Lo que no pongas aquí usa la
                            clasificación general (la de <b>Actividad › Aplicaciones</b> y
                            <b>Sitios</b>). Pon una app <b>o</b> un sitio por renglón, y su
                            categoría. El histórico de este perfil se reacomoda al guardar.
                        </div>
                        <field name="category_ids" nolabel="1" colspan="2">
                            <list editable="bottom">
                                <field name="app_id" options="{'no_create_edit': True}"
                                       placeholder="una app (WhatsApp, Spotify…)"/>
                                <field name="site_id" options="{'no_create_edit': True}"
                                       placeholder="o un sitio (web.whatsapp.com, youtube.com…)"/>
                                <field name="category_id" options="{'no_create_edit': True}"
                                       placeholder="Productiva / Distraccion…"/>
                            </list>
                        </field>
                    </group>

                    <group>
                        <field name="note" string="Para qué es este perfil"
                               placeholder="Quién lo usa y por qué. Se lee el día que alguien pregunte por qué no puede abrir un sitio."/>
                        <field name="version" readonly="1" groups="base.group_no_one"/>
                        <field name="active" invisible="1"/>
                    </group>

                    <!-- 3. LO QUE SE ESCAPA. Solo aparece si hay algo que
                         decir: una pestana vacia permanente ensena a ignorarla. -->
                    <div invisible="not sitios_sin_cubrir_ids">
                        <group string="5 · Se ha visto y no lo alcanza ninguna regla">
                            <div colspan="2" class="alert alert-warning" role="alert">
                                <field name="cobertura_nota" nolabel="1" readonly="1"/>
                                <div class="mt8">
                                    Un dominio distinto con el mismo contenido
                                    (<code>youtu.be</code> contra <code>youtube.com</code>)
                                    no lo alcanza ninguna regla del otro.
                                </div>
                                <button name="action_bloquear_sugeridos" type="object"
                                        string="Agregarlos como bloqueados"
                                        class="btn-primary btn-sm mt8"/>
                            </div>
                            <!-- El contexto lleva el perfil: el boton de cada
                                 renglon agrega la regla A ESTE perfil, y sin
                                 el no sabria a cual. -->
                            <field name="sitios_sin_cubrir_ids" nolabel="1" colspan="2"
                                   readonly="1" context="{'foco_policy_id': id}">
                                <list>
                                    <field name="host"/>
                                    <field name="category_id"/>
                                    <field name="last_seen"/>
                                    <!-- Uno por uno, no solo todos de golpe:
                                         el boton de arriba agrega la lista
                                         completa, y casi nunca se quiere
                                         bloquear TODO lo que aparecio. -->
                                    <button name="action_bloquear_en_perfil"
                                            type="object" icon="fa-ban"
                                            string="Bloquear"
                                            title="Agregar este sitio como regla de bloqueo de este perfil"/>
                                </list>
                            </field>
                        </group>
                    </div>
                    <field name="cobertura_nota" invisible="1"/>

                    <!-- El estado POR EQUIPO: si llego o no. Sin esto, "lo
                         bloquee en Odoo" y "esta bloqueado en la maquina" se
                         leen igual. -->
                    <group string="Cómo va en cada equipo" invisible="not computer_ids">
                        <field name="computer_ids" nolabel="1" colspan="2" readonly="1">
                            <list>
                                <field name="name"/>
                                <field name="employee_id"/>
                                <field name="policy_sync" string="Bloqueo"
                                       decoration-warning="policy_sync in ('pendiente','nunca')"
                                       decoration-muted="policy_sync in ('off','sin_perfil')"/>
                                <field name="policy_applied_at" string="Aplicada"/>
                                <field name="policy_detail" string="Detalle" optional="hide"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="foco_policy_view_search" model="ir.ui.view">
        <field name="name">foco.policy.search</field>
        <field name="model">foco.policy</field>
        <field name="arch" type="xml">
            <search string="Perfiles">
                <field name="name"/>
                <field name="rule_ids" string="Patron"
                       filter_domain="[('rule_ids.pattern','ilike',self)]"/>
                <field name="computer_assign_ids" string="Equipo"/>
                <separator/>
                <filter name="sin_equipos" string="Sin equipos asignados"
                        domain="[('computer_ids','=',False)]"/>
                <filter name="archivados" string="Archivados" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <record id="foco_policy_action" model="ir.actions.act_window">
        <field name="name">Navegacion permitida</field>
        <field name="res_model">foco.policy</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea el primer perfil</p>
            <p>
                Un perfil es una lista de sitios que un grupo de equipos puede o
                no puede abrir. Se arma en tres pasos: eliges los equipos,
                escribes las reglas y enciendes el bloqueo.
            </p>
            <p>
                El equipo la recoge en su siguiente envio -cinco minutos- y el
                navegador deja de cargar el sitio, sin que el usuario tenga que
                hacer nada.
            </p>
        </field>
    </record>

</odoo>
