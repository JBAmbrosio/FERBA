<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lo que el administrador ve de una llamada: cuando, cuanto, con que
         rol y el veredicto. Nunca el contenido: la transcripcion se borra al
         decidir y el audio no se guarda en ningun momento. -->
    <record id="foco_call_review_view_list" model="ir.ui.view">
        <field name="name">foco.call.review.list</field>
        <field name="model">foco.call.review</field>
        <field name="arch" type="xml">
            <list decoration-success="clasificacion == 'trabajo'"
                  decoration-danger="clasificacion == 'personal'"
                  decoration-warning="clasificacion == 'mixta'"
                  decoration-muted="state in ('grabando', 'transcribiendo', 'por_clasificar', 'error')">
                <field name="started_at"/>
                <field name="employee_id"/>
                <field name="computer_id" optional="hide"/>
                <field name="duration_text"/>
                <field name="clasificacion" widget="badge"
                       decoration-success="clasificacion == 'trabajo'"
                       decoration-danger="clasificacion == 'personal'"
                       decoration-warning="clasificacion == 'mixta'"/>
                <field name="con_quien"/>
                <field name="motivo"/>
                <field name="confianza" widget="percentage" optional="show"/>
                <field name="state" optional="show"/>
                <field name="app" optional="hide"/>
                <field name="audio_seconds" optional="hide"/>
                <field name="transcript_cleared" optional="hide"/>
                <field name="error_detail" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="foco_call_review_view_form" model="ir.ui.view">
        <field name="name">foco.call.review.form</field>
        <field name="model">foco.call.review</field>
        <field name="arch" type="xml">
            <form string="Llamada analizada" create="false" edit="false">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Aqui no hay audio ni transcripcion: el audio se transcribio al
                        llegar y se descarto, y la transcripcion se borro en cuanto el
                        modelo decidio. Queda el veredicto, no lo que se dijo.
                    </div>
                    <group>
                        <group string="Llamada">
                            <field name="employee_id"/>
                            <field name="computer_id"/>
                            <field name="app"/>
                            <field name="started_at"/>
                            <field name="ended_at"/>
                            <field name="duration_text"/>
                            <field name="state"/>
                        </group>
                        <group string="Veredicto">
                            <field name="clasificacion"/>
                            <field name="confianza" widget="percentage"/>
                            <field name="con_quien"/>
                            <field name="motivo"/>
                            <field name="decided_at"/>
                            <field name="modelo"/>
                        </group>
                        <group string="Rastro tecnico">
                            <field name="ref"/>
                            <field name="chunks_received"/>
                            <field name="audio_seconds"/>
                            <field name="transcript_chars"/>
                            <field name="transcript_cleared"/>
                            <field name="tokens"/>
                            <field name="retries"/>
                            <field name="error_detail"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="foco_call_review_view_search" model="ir.ui.view">
        <field name="name">foco.call.review.search</field>
        <field name="model">foco.call.review</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="computer_id"/>
                <field name="motivo"/>
                <filter name="trabajo" string="Trabajo" domain="[('clasificacion', '=', 'trabajo')]"/>
                <filter name="personal" string="Personal" domain="[('clasificacion', '=', 'personal')]"/>
                <filter name="mixta" string="Mixta" domain="[('clasificacion', '=', 'mixta')]"/>
                <filter name="indeterminada" string="Indeterminada" domain="[('clasificacion', '=', 'indeterminada')]"/>
                <separator/>
                <filter name="pendientes" string="Sin veredicto todavia"
                        domain="[('state', 'in', ('grabando', 'transcribiendo', 'por_clasificar', 'error'))]"/>
                <filter name="con_error" string="Con error" domain="[('state', '=', 'error')]"/>
                <separator/>
                <filter name="hoy" string="Hoy" date="started_at" default_period="today"/>
                <group expand="0" string="Agrupar por">
                    <filter name="g_empleado" string="Empleado" context="{'group_by': 'employee_id'}"/>
                    <filter name="g_veredicto" string="Veredicto" context="{'group_by': 'clasificacion'}"/>
                    <filter name="g_dia" string="Dia" context="{'group_by': 'started_at:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="foco_call_review_action" model="ir.actions.act_window">
        <field name="name">Llamadas de WhatsApp (laptop)</field>
        <field name="res_model">foco.call.review</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_g_empleado': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Todavia no hay llamadas analizadas</p>
            <p>Aparecen cuando un equipo con el analisis encendido (Configuracion y la marca
               del equipo) detecta una llamada de WhatsApp. Se guarda el veredicto, nunca la
               llamada.</p>
        </field>
    </record>
</odoo>
