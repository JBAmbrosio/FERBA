<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_aprobacion" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.ferba.aprobacion</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Botones del flujo y su barra de estado, antes de la barra de Odoo -->
            <xpath expr="//header/field[@name='state']" position="before">
                <field name="requiere_aprobacion" invisible="1"/>
                <field name="puede_aprobar" invisible="1"/>
                <button name="action_enviar_revision" type="object" string="Enviar a revision"
                        class="btn-primary" data-hotkey="r"
                        invisible="not requiere_aprobacion or aprobacion_state not in ('sin', 'rechazada')"/>
                <!-- El aprobador aprueba desde cualquier estado: no tiene que mandarse
                     la cotizacion a revision a si mismo (19.0.1.2.0). -->
                <button name="action_aprobar" type="object" string="Aprobar"
                        class="btn-primary" data-hotkey="a"
                        groups="ferba_aprobacion_cotizaciones.group_aprobador_cotizaciones"
                        invisible="not requiere_aprobacion or aprobacion_state == 'aprobada'"/>
                <button name="action_rechazar" type="object" string="Rechazar"
                        class="btn-secondary"
                        groups="ferba_aprobacion_cotizaciones.group_aprobador_cotizaciones"
                        invisible="not requiere_aprobacion or aprobacion_state not in ('sin', 'revision')"/>
                <field name="aprobacion_state" widget="statusbar" statusbar_visible="sin,revision,aprobada"
                       invisible="not requiere_aprobacion and aprobacion_state == 'sin'"/>
            </xpath>

            <!-- Mientras no este aprobada, del encabezado solo se ven «Enviar a
                 revision» y «Cancelar» (mas «Aprobar» y «Rechazar» para los
                 aprobadores). Enviar, Confirmar, Vista previa, Imprimir, PROFORMA y
                 los botones de Studio aparecen al aprobarse. Eso ya no va aqui con un
                 xpath por boton: lo hace sale.order._get_view sobre la vista ya
                 combinada (19.0.1.4.0), asi cubre tambien los botones que agregue
                 Studio u otro modulo. Las compuertas de enviar y confirmar siguen en
                 Python (action_quotation_send / action_confirm). -->


            <!-- Lo que le pasa a la cotizacion se dice arriba, no hay que buscarlo -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-info mb-0" role="alert"
                     invisible="not requiere_aprobacion or aprobacion_state != 'revision'">
                    En revision desde <field name="aprobacion_solicitud_fecha" readonly="1" class="fw-bold"/>
                    (la mando <field name="aprobacion_solicitante_id" readonly="1" class="fw-bold"/>).
                    Hasta que un aprobador la apruebe no se puede enviar ni confirmar.
                </div>
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="not requiere_aprobacion or aprobacion_state != 'rechazada'">
                    <strong>Rechazada</strong> por <field name="aprobacion_user_id" readonly="1" class="fw-bold"/>:
                    <field name="aprobacion_motivo" readonly="1" class="fw-bold"/>
                    Corrigela y vuelve a mandarla a revision.
                </div>
                <!-- La aprobacion se retiro por un cambio: antes solo quedaba en el
                     chatter y el vendedor no entendia por que Enviar se detenia. -->
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="not requiere_aprobacion or aprobacion_state != 'sin' or not aprobacion_retirada">
                    <strong>La aprobacion se retiro:</strong>
                    <field name="aprobacion_retirada" readonly="1" class="fw-bold"/>.
                    Hay que mandarla a revision otra vez (o que un aprobador la apruebe).
                </div>
            </xpath>

            <!-- Trazabilidad en "Otra informacion" -->
            <xpath expr="//page[@name='other_information']//group[@name='sales_person']" position="after">
                <group name="ferba_aprobacion" string="Aprobacion" invisible="aprobacion_state == 'sin' and not aprobacion_solicitante_id">
                    <field name="aprobacion_solicitante_id"/>
                    <field name="aprobacion_solicitud_fecha"/>
                    <field name="aprobacion_user_id"/>
                    <field name="aprobacion_fecha"/>
                    <field name="aprobacion_motivo" invisible="not aprobacion_motivo"/>
                    <field name="aprobacion_retirada" invisible="not aprobacion_retirada"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_quotation_tree_inherit_aprobacion" model="ir.ui.view">
        <field name="name">sale.order.list.quotation.inherit.ferba.aprobacion</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <!-- `requiere_aprobacion` (oculto) viaja para que el engrane de la
                     lista sepa, por fila seleccionada, si la cotizacion esta
                     liberada; `aprobacion_state` tambien lo usa el badge. -->
                <field name="requiere_aprobacion" column_invisible="1"/>
                <field name="aprobacion_state" string="Aprobacion" optional="show" widget="badge"
                       decoration-info="aprobacion_state == 'revision'"
                       decoration-success="aprobacion_state == 'aprobada'"
                       decoration-danger="aprobacion_state == 'rechazada'"/>
            </xpath>
        </field>
    </record>

    <record id="view_sales_order_filter_inherit_aprobacion" model="ir.ui.view">
        <field name="name">sale.order.search.inherit.ferba.aprobacion</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_sale_orders_filter']" position="after">
                <separator/>
                <filter name="ferba_por_aprobar" string="Por aprobar" domain="[('aprobacion_state', '=', 'revision')]"/>
                <filter name="ferba_aprobadas" string="Aprobadas" domain="[('aprobacion_state', '=', 'aprobada')]"/>
                <filter name="ferba_rechazadas" string="Rechazadas" domain="[('aprobacion_state', '=', 'rechazada')]"/>
            </xpath>
        </field>
    </record>
</odoo>
