<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_aprobacion" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ferba.aprobacion</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='quotation_order_setting_container']" position="inside">
                <setting id="ferba_aprobacion_cotizaciones_setting" string="Aprobacion de cotizaciones"
                         help="El vendedor manda la cotizacion a revision; hasta que un aprobador la apruebe no se puede enviar al cliente ni confirmar. Al aprobar o rechazar se le avisa al vendedor.">
                    <field name="ferba_aprobacion_cotizaciones"/>
                    <div class="content-group" invisible="not ferba_aprobacion_cotizaciones">
                        <div class="mt16">
                            <label for="ferba_aprobadores_ids" string="Aprobadores" class="o_light_label"/>
                            <field name="ferba_aprobadores_ids" widget="many2many_tags"
                                   options="{'no_create': True, 'no_quick_create': True}"
                                   domain="[('share', '=', False)]"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
