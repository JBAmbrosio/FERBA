<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Las fotos de las marcas se borran pasados N dias
             (parametro ferba_checador.dias_foto, 90 por defecto). -->
        <record id="cron_borrar_fotos" model="ir.cron">
            <field name="name">Checador: borrar fotos antiguas</field>
            <field name="model_id" ref="model_ferba_checador_evento"/>
            <field name="state">code</field>
            <field name="code">model.cron_borrar_fotos()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
