<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
  <t t-name="ferba_almacen_facil.App">
    <div class="o_ferba_almacen">

      <!-- ====================== CARGANDO ====================== -->
      <t t-if="state.loading">
        <div class="af-center">
          <div class="af-spinner"/>
          <div class="af-muted">Un momento…</div>
        </div>
      </t>

      <t t-else="">

        <!-- ====================== INICIO ====================== -->
        <t t-if="state.screen === 'inicio'">
          <div class="af-wrap af-fade">
            <header class="af-hero">
              <span class="af-hero-chip"><i class="fa fa-archive"/></span>
              <div class="af-hero-txt">
                <div class="af-hero-app">Almacén</div>
                <div class="af-hero-hola">Hola, <t t-esc="state.resumen.usuario"/></div>
              </div>
            </header>

            <div class="af-tiles">
              <button class="af-tile" t-on-click="() => this.abrirLista('recibir')">
                <span class="af-ico af-ico-recibir"><i class="fa fa-download"/></span>
                <span class="af-tile-nombre">Recibir</span>
                <span class="af-tile-sub">lo que llega</span>
                <span class="af-badge" t-esc="state.resumen.recepciones"/>
              </button>

              <button class="af-tile" t-on-click="() => this.abrirLista('entregar')">
                <span class="af-ico af-ico-entregar"><i class="fa fa-upload"/></span>
                <span class="af-tile-nombre">Entregar</span>
                <span class="af-tile-sub">lo que sale</span>
                <span class="af-badge af-badge-azul" t-esc="state.resumen.entregas"/>
              </button>
            </div>

            <button class="af-tile af-tile-wide" t-on-click="() => this.irBuscar()">
              <span class="af-ico af-ico-buscar"><i class="fa fa-search"/></span>
              <span class="af-tile-txt-wide">
                <span class="af-tile-nombre">Buscar</span>
                <span class="af-tile-sub">pieza u orden</span>
              </span>
            </button>
          </div>
        </t>

        <!-- ====================== LISTA ====================== -->
        <t t-if="state.screen === 'lista'">
          <div class="af-wrap af-fade">
            <header class="af-top">
              <button class="af-volver" aria-label="Volver" t-on-click="() => this.volver()"><i class="fa fa-angle-left"/></button>
              <div class="af-top-titulo" t-esc="state.modo === 'entregar' ? 'Lo que sale' : 'Lo que llega'"/>
              <div class="af-top-conteo" t-esc="state.lista.length"/>
            </header>

            <t t-if="state.lista.length === 0">
              <div class="af-vacio">
                <span class="af-vacio-ico"><i class="fa fa-check-circle"/></span>
                <div t-esc="state.modo === 'entregar' ? 'No hay nada pendiente por entregar' : 'No hay nada pendiente por recibir'"/>
              </div>
            </t>

            <div class="af-cards">
              <t t-foreach="state.lista" t-as="r" t-key="r.id">
                <button t-attf-class="af-card af-{{ color(r.dias) }}" t-on-click="() => this.abrirDetalle(r.id)">
                  <div class="af-card-head">
                    <span class="af-card-folio" t-esc="r.name"/>
                    <span class="af-card-dias" t-esc="textoDias(r.dias)"/>
                  </div>
                  <div class="af-card-socio" t-esc="r.socio"/>
                  <t t-if="r.proyecto">
                    <div class="af-card-proy" t-esc="r.proyecto"/>
                  </t>
                  <div class="af-card-pie">
                    <span class="af-chip"><b t-esc="r.piezas"/> piezas</span>
                    <span class="af-chip af-chip-soft"><t t-esc="r.renglones"/> renglones</span>
                    <span class="af-flecha"><i class="fa fa-angle-right"/></span>
                  </div>
                </button>
              </t>
            </div>
          </div>
        </t>

        <!-- ====================== DETALLE ====================== -->
        <t t-if="state.screen === 'detalle' and state.detalle">
          <div class="af-wrap af-fade">
            <header class="af-top">
              <button class="af-volver" aria-label="Volver" t-on-click="() => this.volver()"><i class="fa fa-angle-left"/></button>
              <div class="af-top-titulo" t-esc="state.detalle.name"/>
            </header>

            <div class="af-detcab">
              <div class="af-detcab-socio" t-esc="state.detalle.socio"/>
              <t t-if="state.detalle.proyecto">
                <div class="af-detcab-proy" t-esc="state.detalle.proyecto"/>
              </t>
            </div>

            <div class="af-renglones">
              <t t-foreach="state.detalle.renglones" t-as="l" t-key="l_index">
                <div class="af-renglon">
                  <div class="af-renglon-info">
                    <div class="af-renglon-prod" t-esc="l.producto"/>
                    <div class="af-renglon-meta">
                      <t t-if="l.codigo"><span class="af-renglon-cod" t-esc="l.codigo"/></t>
                      <span class="af-renglon-ped"><t t-esc="state.modo === 'entregar' ? 'Salen:' : 'Pedido:'"/> <t t-esc="l.demanda"/> <t t-esc="l.unidad"/></span>
                      <t t-if="l.disponible !== null">
                        <span t-attf-class="af-renglon-disp {{ l.disponible &lt; (parseFloat(l.recibido) || 0) ? 'af-disp-bajo' : '' }}">· Hay <t t-esc="l.disponible"/></span>
                      </t>
                    </div>
                    <t t-if="l.novedad">
                      <span class="af-nov-chip"><i class="fa fa-exclamation-triangle"/> <t t-esc="l.novedad"/></span>
                    </t>
                  </div>
                  <div class="af-renglon-ctrl">
                    <div class="af-stepper">
                      <button class="af-step" aria-label="menos" t-on-click="() => this.dec(l)"><i class="fa fa-minus"/></button>
                      <input class="af-step-num" type="number" inputmode="decimal" min="0" step="1"
                             t-att-value="l.recibido" t-on-input="(ev) => this.setCant(l, ev)"/>
                      <button class="af-step" aria-label="más" t-on-click="() => this.inc(l)"><i class="fa fa-plus"/></button>
                    </div>
                    <button class="af-nov-btn" t-on-click="() => this.toggleNovedad(l)"><i class="fa fa-flag"/> Novedad</button>
                  </div>
                </div>
                <t t-if="l.novedadAbierta">
                  <div class="af-nov-panel">
                    <button t-attf-class="af-nov-op {{ l.novedad === 'Dañado' ? 'on' : '' }}" t-on-click="() => this.setNovedad(l, 'Dañado')">Dañado</button>
                    <button t-attf-class="af-nov-op {{ l.novedad === 'Incorrecto' ? 'on' : '' }}" t-on-click="() => this.setNovedad(l, 'Incorrecto')">Incorrecto</button>
                    <button t-attf-class="af-nov-op {{ l.novedad === 'Sobrante' ? 'on' : '' }}" t-on-click="() => this.setNovedad(l, 'Sobrante')">Sobrante</button>
                    <button t-attf-class="af-nov-op {{ l.novedad === 'Otro' ? 'on' : '' }}" t-on-click="() => this.setNovedad(l, 'Otro')">Otro</button>
                  </div>
                </t>
              </t>
            </div>

            <!-- Firma -->
            <div class="af-firma-bloque">
              <div class="af-firma-label">
                <span><i class="fa fa-pencil"/> <t t-esc="state.modo === 'entregar' ? 'Firma de entrega' : 'Firma de quien recibe'"/></span>
                <button class="af-firma-limpia" t-on-click="() => this.firmaLimpia()">Borrar</button>
              </div>
              <canvas t-ref="firma" class="af-firma" width="600" height="180"
                      t-on-pointerdown="(ev) => this.firmaInicio(ev)"
                      t-on-pointermove="(ev) => this.firmaMueve(ev)"
                      t-on-pointerup="() => this.firmaFin()"
                      t-on-pointerleave="() => this.firmaFin()"/>
            </div>

            <!-- Acción -->
            <div class="af-acciones">
              <button t-attf-class="af-btn {{ state.modo === 'entregar' ? 'af-btn-entregar' : 'af-btn-recibir' }}" t-att-disabled="state.enviando" t-on-click="() => this.procesar()">
                <t t-if="state.enviando"><span class="af-btn-spin"/> Procesando…</t>
                <t t-else="">
                  <i class="fa fa-check"/>
                  <t t-if="hayParcial()">
                    <t t-esc="state.modo === 'entregar' ? 'ENTREGAR LO MARCADO' : 'RECIBIR LO QUE LLEGÓ'"/>
                  </t>
                  <t t-else="">
                    <t t-esc="state.modo === 'entregar' ? 'ENTREGAR TODO' : 'RECIBIR TODO'"/>
                  </t>
                </t>
              </button>
              <t t-if="hayParcial()">
                <div class="af-parcial-aviso"><i class="fa fa-info-circle"/> Lo que falte quedará pendiente para después.</div>
              </t>
            </div>
          </div>
        </t>

        <!-- ====================== BUSCAR ====================== -->
        <t t-if="state.screen === 'buscar'">
          <div class="af-wrap af-fade">
            <header class="af-top">
              <button class="af-volver" aria-label="Volver" t-on-click="() => this.volver()"><i class="fa fa-angle-left"/></button>
              <div class="af-top-titulo">Buscar</div>
            </header>

            <div class="af-buscador">
              <span class="af-buscador-ico"><i class="fa fa-search"/></span>
              <input type="text" class="af-input" placeholder="Pieza, código u orden…"
                     t-att-value="state.busqueda" t-on-input="(ev) => this.buscar(ev)"/>
            </div>

            <t t-if="state.resultados">
              <t t-if="state.resultados.productos.length">
                <div class="af-seccion">Piezas</div>
                <div class="af-cards">
                  <t t-foreach="state.resultados.productos" t-as="p" t-key="'p'+p.id">
                    <div class="af-res">
                      <div class="af-res-info">
                        <div class="af-res-nombre" t-esc="p.nombre"/>
                        <t t-if="p.codigo"><div class="af-res-cod" t-esc="p.codigo"/></t>
                      </div>
                      <div class="af-res-stock">
                        <span class="af-stock-num" t-esc="p.existencia"/>
                        <span class="af-stock-uni" t-esc="p.unidad"/>
                      </div>
                    </div>
                  </t>
                </div>
              </t>
              <t t-if="state.resultados.ordenes.length">
                <div class="af-seccion">Órdenes / recepciones</div>
                <div class="af-cards">
                  <t t-foreach="state.resultados.ordenes" t-as="o" t-key="'o'+o.id">
                    <div class="af-res">
                      <div class="af-res-info">
                        <div class="af-res-nombre"><t t-esc="o.tipo"/> <t t-esc="o.name"/></div>
                        <t t-if="o.origen"><div class="af-res-cod" t-esc="o.origen"/></t>
                      </div>
                      <div class="af-res-estado" t-esc="o.estado"/>
                    </div>
                  </t>
                </div>
              </t>
              <t t-if="!state.resultados.productos.length and !state.resultados.ordenes.length">
                <div class="af-vacio">
                  <span class="af-vacio-ico af-vacio-ico-muted"><i class="fa fa-search"/></span>
                  <div>No encontré nada con eso</div>
                </div>
              </t>
            </t>
            <t t-else="">
              <div class="af-ayuda">Escribe al menos 2 letras para buscar.</div>
            </t>
          </div>
        </t>

      </t>
    </div>
  </t>
</templates>
