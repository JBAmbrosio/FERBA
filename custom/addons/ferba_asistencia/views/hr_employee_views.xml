<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Interruptor "controla asistencia" junto al horario de trabajo. -->
    <record id="view_employee_form_ferba_asistencia" model="ir.ui.view">
        <field name="name">hr.employee.form.ferba.asistencia</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='resource_calendar_id']" position="after">
                <field name="ferba_controla_asistencia"/>
            </xpath>
        </field>
    </record>
</odoo>
