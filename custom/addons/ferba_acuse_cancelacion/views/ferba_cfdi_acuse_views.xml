<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Nota que se deja en el historial de la factura/pago al guardar el acuse -->
    <template id="message_acuse_saved">
        <p>Se guardó el <b>acuse de solicitud de cancelación</b> que devolvió el SAT a través de SW.</p>
        <ul>
            <li>UUID: <t t-esc="acuse.uuid"/></li>
            <li>Código de SW: <t t-esc="code_text"/></li>
            <li>Fecha del acuse (SAT): <t t-esc="acuse.sat_date or 'no viene en el acuse'"/></li>
            <li>Estatus en el acuse: <t t-esc="acuse.sat_status or 'no viene en el acuse'"/></li>
        </ul>
        <p t-if="acuse.parse_error">No se pudo leer el contenido del acuse; se guardó el XML tal como llegó.</p>
        <p>El XML firmado por el SAT va adjunto.</p>
    </template>

    <record id="view_ferba_cfdi_acuse_list" model="ir.ui.view">
        <field name="name">ferba.cfdi.acuse.list</field>
        <field name="model">ferba.cfdi.acuse</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="create_date" string="Registrado"/>
                <field name="sat_date"/>
                <field name="uuid"/>
                <field name="move_id"/>
                <field name="partner_id" optional="show"/>
                <field name="cancellation_reason" optional="show"/>
                <field name="sw_code"/>
                <field name="sat_status" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_ferba_cfdi_acuse_form" model="ir.ui.view">
        <field name="name">ferba.cfdi.acuse.form</field>
        <field name="model">ferba.cfdi.acuse</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <header>
                    <button name="%(ferba_acuse_cancelacion.action_report_ferba_cfdi_acuse)d" type="action"
                            string="Imprimir acuse (PDF)" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="uuid"/></h1>
                    </div>
                    <group>
                        <group string="Solicitud">
                            <field name="move_id"/>
                            <field name="partner_id"/>
                            <field name="invoice_ids" widget="many2many_tags" invisible="not invoice_ids"/>
                            <field name="cancellation_reason"/>
                            <field name="substitution_uuid" invisible="not substitution_uuid"/>
                            <field name="pac"/>
                            <field name="sw_code"/>
                            <field name="sw_code_description"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Acuse del SAT">
                            <field name="sat_date"/>
                            <field name="sat_rfc_emisor"/>
                            <field name="sat_uuid"/>
                            <field name="sat_status"/>
                            <field name="sat_signed"/>
                            <field name="parse_error" invisible="not parse_error"/>
                            <field name="acuse_xml" filename="acuse_filename"/>
                            <field name="acuse_filename" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ferba_cfdi_acuse_search" model="ir.ui.view">
        <field name="name">ferba.cfdi.acuse.search</field>
        <field name="model">ferba.cfdi.acuse</field>
        <field name="arch" type="xml">
            <search>
                <field name="uuid"/>
                <field name="move_id"/>
                <field name="partner_id"/>
                <group>
                    <filter name="group_company" string="Empresa" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ferba_cfdi_acuse" model="ir.actions.act_window">
        <field name="name">Acuses de cancelación</field>
        <field name="res_model">ferba.cfdi.acuse</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Todavía no hay acuses de cancelación</p>
            <p>Aquí aparecen los acuses que el SAT devuelve (a través de SW) cada vez que se solicita la
               cancelación de un CFDI. Las cancelaciones anteriores a este módulo no tienen acuse guardado.</p>
        </field>
    </record>

    <menuitem id="menu_ferba_cfdi_acuse"
              name="Acuses de cancelación"
              parent="account.menu_finance_receivables"
              action="action_ferba_cfdi_acuse"
              groups="account.group_account_invoice,account.group_account_readonly"
              sequence="90"/>
</odoo>
